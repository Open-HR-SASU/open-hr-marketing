// Get locale-appropriate fallback
const FALLBACK_FOOTER = FALLBACK_FOOTERS[locale] || FALLBACK_FOOTERS['en-US'];

// Build locale-prefixed href with trailing slash for static hosting
function buildHref(href: string): string {
  if (href.startsWith('http') || href.startsWith('#')) {
    return href;
  }
  const cleanHref = href.startsWith('/') ? href.slice(1) : href;
  // Ensure trailing slash for Bunny Edge Storage compatibility
  const path = cleanHref.endsWith('/') ? cleanHref : `${cleanHref}/`;
  return `/${locale}/${path}`.replace(/\/+/g, '/');
}

// Fetch footer
let footerData: typeof FALLBACK_FOOTER;
try {
  const sanityFooter = await getFooter(locale);
  if (sanityFooter && sanityFooter.columns && sanityFooter.columns.length > 0) {
    footerData = {
      columns: sanityFooter.columns,
      copyrightText: sanityFooter.copyrightText || FALLBACK_FOOTER.copyrightText,
    };
  } else {
    footerData = FALLBACK_FOOTER;
  }
} catch {
  footerData = FALLBACK_FOOTER;
}

const currentYear = new Date().getFullYear();
const copyrightText = footerData.copyrightText.replace('{year}', String(currentYear));
---

<footer class="border-t border-gray-200 bg-background">
  <div class="container mx-auto px-4 py-12 sm:px-6">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <Mark size="sm" class="text-primary" />
          <span class="font-display text-lg font-semibold">
            Open HR
          </span>
        </div>
        <p class="text-sm text-gray-600">
          Employment infrastructure. RH pour tous.
        </p>
        <!-- Social Links -->
        <div class="flex gap-4">
          {SOCIAL_LINKS.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-500 transition-colors hover:text-primary"
              aria-label={`Follow us on ${social.name}`}
              set:html={social.icon}
            />
          ))}
        </div>
      </div>

      <!-- Dynamic Columns -->
      {footerData.columns.map((column) => (
        <div>
          <h3 class="mb-4 text-sm font-semibold text-foreground">
            {column.title}
          </h3>
          <ul class="space-y-3 text-sm">
            {column.links.map((link) => (
              <li>
                <a
                  href={buildHref(link.href)}
                  class="text-gray-600 hover:text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Copyright -->
    <div class="mt-12 border-t border-gray-200 pt-8">
      <p class="text-center text-sm text-gray-600">
        {copyrightText}
      </p>
    </div>
  </div>
</footer>
