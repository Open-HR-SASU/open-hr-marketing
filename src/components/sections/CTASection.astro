---
/**
 * CTA Section
 *
 * Call-to-action banner with prominent buttons.
 * Used for conversion-focused messaging.
 */

import { RichText } from './RichText';
import { getBackgroundClass, type SectionProps } from './types';

interface Props extends Partial<SectionProps> {}

const {
  heading,
  subheading,
  body,
  ctaText,
  ctaLink,
  ctaSecondaryText,
  ctaSecondaryLink,
  backgroundStyle,
  className = '',
} = Astro.props;

const bgClass = getBackgroundClass(backgroundStyle ?? 'light');
---

<section class:list={['py-16 md:py-20', bgClass, className]}>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      {heading && (
        <h2 class="mb-4 font-display text-3xl font-bold text-foreground md:text-4xl">
          {heading}
        </h2>
      )}
      {subheading && (
        <p class="mb-6 text-lg text-gray-600">{subheading}</p>
      )}
      {body && body.length > 0 && (
        <div class="mb-8">
          <RichText content={body} className="text-gray-600" />
        </div>
      )}

      <!-- CTA Buttons -->
      {(ctaText || ctaSecondaryText) && (
        <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
          {ctaText && ctaLink && (
            <a
              href={ctaLink}
              class="rounded-md bg-openhr-teal-900 px-8 py-3 font-medium text-white transition-all hover:bg-openhr-teal-800"
            >
              {ctaText}
            </a>
          )}
          {ctaSecondaryText && ctaSecondaryLink && (
            <a
              href={ctaSecondaryLink}
              class="rounded-md border border-gray-300 bg-white px-8 py-3 font-medium text-gray-700 transition-all hover:bg-gray-50"
            >
              {ctaSecondaryText}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
