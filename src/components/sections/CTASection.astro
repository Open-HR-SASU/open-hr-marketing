---
/**
 * CTA Section
 *
 * Call-to-action banner with prominent buttons.
 * Used for conversion-focused messaging.
 */

import { RichText } from './RichText';
import { getBackgroundClass, type SectionProps } from './types';

interface Props extends Partial<SectionProps> {}

const {
  heading,
  subheading,
  body,
  ctaText,
  ctaLink,
  ctaSecondaryText,
  ctaSecondaryLink,
  backgroundStyle,
  className = '',
} = Astro.props;

const bgClass = getBackgroundClass(backgroundStyle ?? 'light');
const isOnDarkBg = backgroundStyle === 'brand' || backgroundStyle === 'dark';
---

<section class:list={['py-16 md:py-20', bgClass, className]}>
  <div class="container mx-auto px-4">
    <div class="mx-auto max-w-3xl text-center">
      {heading && (
        <h2 class:list={['mb-4 font-display text-3xl font-bold md:text-4xl', isOnDarkBg ? 'text-white' : 'text-foreground']}>
          {heading}
        </h2>
      )}
      {subheading && (
        <p class:list={['mb-6 text-lg', isOnDarkBg ? 'text-white/80' : 'text-gray-600']}>{subheading}</p>
      )}
      {body && body.length > 0 && (
        <div class="mb-8">
          <RichText content={body} className={isOnDarkBg ? 'text-white/80' : 'text-gray-600'} />
        </div>
      )}

      <!-- CTA Buttons -->
      {(ctaText || ctaSecondaryText) && (
        <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
          {ctaText && ctaLink && (
            <a
              href={ctaLink}
              class:list={[
                'rounded-md px-8 py-3 font-medium transition-all',
                isOnDarkBg
                  ? 'border border-white bg-white text-openhr-teal-900 hover:bg-white/90'
                  : 'bg-openhr-teal-900 text-white hover:bg-openhr-teal-800'
              ]}
            >
              {ctaText}
            </a>
          )}
          {ctaSecondaryText && ctaSecondaryLink && (
            <a
              href={ctaSecondaryLink}
              class:list={[
                'rounded-md border px-8 py-3 font-medium transition-all',
                isOnDarkBg
                  ? 'border-white bg-transparent text-white hover:bg-white/10'
                  : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50'
              ]}
            >
              {ctaSecondaryText}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
