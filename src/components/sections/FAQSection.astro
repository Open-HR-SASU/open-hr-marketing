---
/**
 * FAQ Section
 *
 * Maps features[] from Sanity to an interactive FAQ accordion.
 * Each feature's heading becomes the question, description becomes the answer.
 * Uses FAQAccordion React island for client-side interactivity.
 */

import FAQAccordion from '@/components/islands/FAQAccordion';
import { getBackgroundClass, type SectionProps } from './types';

interface Props extends Partial<SectionProps> {}

const {
  heading,
  subheading,
  features,
  backgroundStyle,
  anchor,
  language = 'en-GB',
  className = '',
} = Astro.props;

const bgClass = getBackgroundClass(backgroundStyle);

// Map features to FAQ items
const faqItems = (features ?? []).map((f) => ({
  question: f.heading ?? '',
  answer: f.description ?? '',
}));

// Locale-aware expand/collapse labels
const expandLabels: Record<string, string> = {
  fr: 'Développer',
  'en-GB': 'Expand',
  'en-US': 'Expand',
  de: 'Erweitern',
  es: 'Expandir',
  it: 'Espandi',
};

const collapseLabels: Record<string, string> = {
  fr: 'Réduire',
  'en-GB': 'Collapse',
  'en-US': 'Collapse',
  de: 'Einklappen',
  es: 'Contraer',
  it: 'Comprimi',
};

const locale = language ?? 'en-GB';
const expandLabel = expandLabels[locale] ?? 'Expand';
const collapseLabel = collapseLabels[locale] ?? 'Collapse';
---

<section class:list={['py-16 md:py-24', bgClass, className]} id={anchor ?? undefined}>
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="mx-auto mb-12 max-w-3xl text-center">
      {heading && (
        <h2 class="mb-4 font-display text-3xl font-bold text-foreground md:text-4xl">
          {heading}
        </h2>
      )}
      {subheading && (
        <p class="text-lg text-gray-600">{subheading}</p>
      )}
    </div>

    <!-- FAQ Accordion -->
    {faqItems.length > 0 && (
      <div class="mx-auto max-w-3xl">
        <FAQAccordion
          client:load
          items={faqItems}
          expandLabel={expandLabel}
          collapseLabel={collapseLabel}
        />
      </div>
    )}
  </div>
</section>
