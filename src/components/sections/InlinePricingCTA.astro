---
/**
 * Inline Pricing CTA — Workers Are Free. Always.
 *
 * Lightweight static single-card "Free" display for homepage.
 * CEO Decision: 2026-03-15 — B2C is free, revenue from B2B employers only.
 */

import { getBackgroundClass, type SectionProps } from './types';

interface Props extends Partial<SectionProps> {}

const {
  heading,
  subheading,
  backgroundStyle,
  anchor,
  language = 'en-GB',
  className = '',
} = Astro.props;

const bgClass = getBackgroundClass(backgroundStyle);
const locale = (language ?? 'en-GB') as string;

// Localized content
const labels: Record<string, {
  price: string;
  subtitle: string;
  feature: string;
  cta: string;
  anchor: string;
}> = {
  fr: {
    price: 'Gratuit',
    subtitle: 'Votre RepScore verifie. Sans frais. Sans conditions.',
    feature: 'References verifiees illimitees + verification d\'identite',
    cta: 'Obtenir mon RefScore',
    anchor: 'Gratuit pour les travailleurs. Toujours.',
  },
  'en-GB': {
    price: 'Free',
    subtitle: 'Your verified RefScore. No cost. No catch.',
    feature: 'Unlimited verified references + identity verification',
    cta: 'Get Your RefScore',
    anchor: 'Free for workers. Always.',
  },
  'en-US': {
    price: 'Free',
    subtitle: 'Your verified RefScore. No cost. No catch.',
    feature: 'Unlimited verified references + identity verification',
    cta: 'Get Your RefScore',
    anchor: 'Free for workers. Always.',
  },
  de: {
    price: 'Kostenlos',
    subtitle: 'Ihr verifizierter RefScore. Keine Kosten. Keine Bedingungen.',
    feature: 'Unbegrenzte verifizierte Referenzen + Identitatsverifizierung',
    cta: 'RefScore holen',
    anchor: 'Kostenlos fur Arbeitnehmer. Immer.',
  },
  es: {
    price: 'Gratis',
    subtitle: 'Tu RefScore verificado. Sin coste. Sin condiciones.',
    feature: 'Referencias verificadas ilimitadas + verificacion de identidad',
    cta: 'Obtener mi RefScore',
    anchor: 'Gratis para trabajadores. Siempre.',
  },
  it: {
    price: 'Gratuito',
    subtitle: 'Il tuo RefScore verificato. Senza costi. Senza condizioni.',
    feature: 'Referenze verificate illimitate + verifica dell\'identita',
    cta: 'Ottieni il mio RefScore',
    anchor: 'Gratuito per i lavoratori. Sempre.',
  },
};

const t = labels[locale] ?? labels['en-GB'];
const signupUrl = 'https://app.open-hr.work/auth/login';
---

<section class:list={['py-16 md:py-24', bgClass, className]} id={anchor ?? undefined}>
  <div class="container mx-auto px-4">
    <!-- Optional Section Header -->
    {heading && (
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <h2 class="mb-4 font-display text-3xl font-bold text-foreground md:text-4xl">
          {heading}
        </h2>
        {subheading && (
          <p class="text-lg text-gray-600">{subheading}</p>
        )}
      </div>
    )}

    <!-- Single Free Card -->
    <div class="mx-auto max-w-lg">
      <div class="relative flex flex-col rounded-2xl border-2 border-openhr-teal-900 bg-white p-8 shadow-lg">
        <!-- Badge -->
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-openhr-teal-900 px-6 py-1.5 text-sm font-semibold text-white whitespace-nowrap">
          {t.anchor}
        </div>

        <div class="mt-4 text-center">
          <span class="text-5xl font-bold text-openhr-teal-900">{t.price}</span>
        </div>
        <p class="mt-4 text-center text-sm text-gray-600">{t.subtitle}</p>
        <div class="mt-6 flex items-start gap-3">
          <svg class="h-5 w-5 flex-shrink-0 text-openhr-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-gray-700">{t.feature}</span>
        </div>
        <a
          href={signupUrl}
          class="mt-8 block w-full rounded-lg bg-openhr-teal-900 px-4 py-3 text-center font-medium text-white transition-colors hover:bg-openhr-teal-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-openhr-teal-900 focus-visible:ring-offset-2"
        >
          {t.cta}
        </a>
      </div>
    </div>
  </div>
</section>
