---
/**
 * Sections Renderer
 *
 * Maps section `sectionType` values to Astro components.
 * Enables dynamic page rendering from Sanity CMS content.
 *
 * Usage:
 *   import SectionsRenderer from '@/components/sections/SectionsRenderer.astro';
 *   <SectionsRenderer sections={page.sections} locale={locale} />
 */

import type { Section, Locale } from '@/lib/sanity/fetchers';
import { sectionToProps } from './types';

// Section Components
import HeroSection from './HeroSection.astro';
import HeroMockupSection from './HeroMockupSection.astro';
import FeaturesSection from './FeaturesSection.astro';
import CTASection from './CTASection.astro';
import ContentSection from './ContentSection.astro';
import AppPreviewSection from './AppPreviewSection.astro';
import ReferenceExperienceSection from './ReferenceExperienceSection.astro';
import FallbackSection from './FallbackSection.astro';

interface Props {
  sections: Section[] | null;
  locale: Locale;
  className?: string;
}

const { sections, locale, className } = Astro.props;
---

{sections && sections.length > 0 && (
  <Fragment>
    {sections.map((section) => {
      const props = sectionToProps(section, locale, className);
      const type = section.sectionType;

      // Map section types to components
      // Using explicit conditionals since Astro doesn't support dynamic component references
      return (
        <Fragment>
          {type === 'hero' && <HeroSection {...props} />}
          {type === 'heroMockup' && <HeroMockupSection {...props} mockupImage={section.mockupImage} />}
          {type === 'features' && <FeaturesSection {...props} />}
          {type === 'cta' && <CTASection {...props} />}
          {type === 'content' && <ContentSection {...props} />}
          {type === 'pricing' && <ContentSection {...props} />}
          {type === 'testimonials' && <ContentSection {...props} />}
          {type === 'faq' && <ContentSection {...props} />}
          {type === 'stats' && <ContentSection {...props} />}
          {/* Process/HowItWorks sections use ReferenceExperienceSection for mockup support */}
          {/* CMS may store steps as flowSteps or features - support both */}
          {type === 'process' && <ReferenceExperienceSection {...props} mockupImages={section.mockupImages ?? []} flowSteps={section.flowSteps ?? section.features?.map((f, i) => ({ _key: f._key, stepNumber: i + 1, title: f.heading, description: f.description })) ?? []} />}
          {type === 'howItWorks' && <ReferenceExperienceSection {...props} mockupImages={section.mockupImages ?? []} flowSteps={section.flowSteps ?? section.features?.map((f, i) => ({ _key: f._key, stepNumber: i + 1, title: f.heading, description: f.description })) ?? []} />}
          {type === 'referenceExperience' && <ReferenceExperienceSection {...props} mockupImages={section.mockupImages ?? []} flowSteps={section.flowSteps ?? section.features?.map((f, i) => ({ _key: f._key, stepNumber: i + 1, title: f.heading, description: f.description })) ?? []} />}
          {type === 'appPreview' && <AppPreviewSection {...props} mockupImages={section.mockupImages ?? []} />}
          {!['hero', 'heroMockup', 'features', 'cta', 'content', 'pricing', 'testimonials', 'faq', 'stats', 'process', 'howItWorks', 'referenceExperience', 'appPreview'].includes(type) && (
            <FallbackSection {...props} />
          )}
        </Fragment>
      );
    })}
  </Fragment>
)}
