---
/**
 * Base Layout for Open HR Marketing Site
 *
 * Provides:
 * - Font loading (Bricolage Grotesque, Instrument Sans, JetBrains Mono, Inter)
 * - Global styles
 * - SEO meta tags
 * - JSON-LD Organization schema (all pages)
 * - Favicon configuration
 *
 * @see OPE-421 - JSON-LD structured data
 */
// Font Loading Strategy (OPE-420 Performance Audit):
// - Only load weights actually used in critical path
// - Bricolage Grotesque 400 removed (headings use 600/800)
// - JetBrains Mono 500/700 removed (only 400 used for code)
// - Inter removed entirely (not used in marketing pages)
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/bricolage-grotesque/800.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/globals.css';
import AnalyticsBanner from '@/components/AnalyticsBanner.astro';
import JsonLd from '@/components/JsonLd.astro';
import { generateOrganizationSchema, type Schema } from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  locale?: string;
  ogImage?: string;
  noIndex?: boolean;
  /** Additional JSON-LD schemas to include alongside Organization */
  additionalSchemas?: Schema[];
  /** Page path for hreflang generation (e.g. '/', '/about/', '/pricing/') */
  pagePath?: string;
}

const {
  title,
  description = "L'infrastructure RH de demain. Open HR.",
  locale = 'fr',
  // TODO(OPE-734): Replace with proper 1200×630 OG image before Product Hunt
  ogImage = '/icon-512x512.png',
  noIndex = false,
  additionalSchemas = [],
  pagePath
} = Astro.props;

// Map locale codes to HTML lang attributes
const localeToLang: Record<string, string> = {
  'fr': 'fr',
  'en-GB': 'en-GB',
  'en-US': 'en',
  'de': 'de',
  'es': 'es',
  'it': 'it'
};

// Map locale codes to hreflang values
const localeToHreflang: Record<string, string> = {
  'fr': 'fr',
  'en-GB': 'en-GB',
  'en-US': 'en-US',
  'de': 'de',
  'es': 'es',
  'it': 'it'
};

const allLocales = ['fr', 'en-GB', 'en-US', 'de', 'es', 'it'];

const htmlLang = localeToLang[locale] || 'fr';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generate Organization schema (included on all pages)
const organizationSchema = generateOrganizationSchema();

// Combine Organization with any additional schemas
const allSchemas = [organizationSchema, ...additionalSchemas];
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta property="og:site_name" content="Open HR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@open_hr_work" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Hreflang (OPE-698) -->
    {pagePath && allLocales.map((loc) => (
      <link rel="alternate" hreflang={localeToHreflang[loc]} href={`https://open-hr.work/${loc}${pagePath === '/' ? '/' : pagePath}`} />
    ))}
    {pagePath && (
      <link rel="alternate" hreflang="x-default" href={`https://open-hr.work/en-GB${pagePath === '/' ? '/' : pagePath}`} />
    )}

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32x32.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192x192.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#006064" />

    <!-- JSON-LD Structured Data (OPE-421) -->
    <JsonLd schemas={allSchemas} />

    <!-- Plausible Analytics (OPE-434: SRI hash added for supply chain security) -->
    <!-- NOTE: SRI hash must be updated if Plausible updates their script. Current version: v33 -->
    <script
      defer
      data-domain="open-hr.fr,open-hr.work"
      src="https://plausible.io/js/script.js"
      integrity="sha384-w94RgU4KLaLtzVlTq9/reBTeZq2r7yYUTi/CYSrWn7J8XNsN/lHYSyeKO2Pqg/ny"
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="antialiased min-h-screen flex flex-col">
    <slot />
    <AnalyticsBanner locale={locale} />
  </body>
</html>
