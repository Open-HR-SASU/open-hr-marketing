---
/**
 * Main Layout for Marketing Pages
 *
 * Includes:
 * - Base Layout (fonts, meta, styles)
 * - Skip link for accessibility (OPE-424)
 * - Header with navigation
 * - Main content slot with landmark
 * - Footer with navigation
 *
 * @see OPE-424 - Skip to main content link
 * @see OPE-421 - JSON-LD structured data
 */
import Layout from './Layout.astro';
import SkipLink from '@/components/SkipLink.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { type Locale } from '@/lib/i18n';
import type { Schema } from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  ogImage?: string;
  noIndex?: boolean;
  /** Additional JSON-LD schemas for page-specific structured data */
  additionalSchemas?: Schema[];
}

const { title, description, locale, ogImage, noIndex, additionalSchemas } = Astro.props;
---

<Layout
  title={title}
  description={description}
  locale={locale}
  ogImage={ogImage}
  noIndex={noIndex}
  additionalSchemas={additionalSchemas}
>
  <SkipLink locale={locale} />
  <Header locale={locale} />
  <main id="main-content" tabindex="-1" class="flex-1 outline-none">
    <slot />
  </main>
  <Footer locale={locale} />
</Layout>
