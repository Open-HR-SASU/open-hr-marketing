---
/**
 * 404 Not Found Page
 *
 * Static 404 page served by Bunny Edge Storage when a route is not found.
 * Defaults to en-GB as the international language, with links to all locales.
 *
 * @see DL-26 — Global access enabled 2026-02-11
 */
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Mark from '@/components/Mark.astro';

const locale = 'en-GB';

const content = {
  title: 'Page Not Found - Open HR',
  heading: 'Page not found',
  message: 'Sorry, the page you are looking for does not exist or has been moved.',
  cta: 'Back to Home',
};

const localeLinks = [
  { code: 'en-GB', label: 'English (UK)', href: '/en-GB/' },
  { code: 'en-US', label: 'English (US)', href: '/en-US/' },
  { code: 'fr', label: 'Francais', href: '/fr/' },
  { code: 'de', label: 'Deutsch', href: '/de/' },
  { code: 'es', label: 'Espanol', href: '/es/' },
  { code: 'it', label: 'Italiano', href: '/it/' },
];
---

<Layout
  title={content.title}
  description={content.message}
  locale={locale}
  noIndex={true}
>
  <Header locale={locale} />
  <main class="flex-1">
    <section class="container flex min-h-[60vh] flex-col items-center justify-center py-16 text-center md:py-24">
      <div class="mb-8">
        <Mark size="xl" class="text-gray-300" />
      </div>

      <h1 class="mb-4 font-display text-6xl font-extrabold text-gray-900 md:text-8xl">
        404
      </h1>

      <div class="mb-8">
        <h2 class="mb-2 text-2xl font-bold text-gray-700">
          {content.heading}
        </h2>
        <p class="text-lg text-gray-600">
          {content.message}
        </p>
      </div>

      <div class="mb-8">
        <a
          href="/en-GB/"
          class="rounded-lg bg-openhr-teal-900 px-6 py-3 font-medium text-white transition-colors hover:bg-openhr-teal-800"
        >
          {content.cta}
        </a>
      </div>

      <!-- Language switcher -->
      <div class="border-t border-gray-200 pt-6">
        <p class="mb-3 text-sm text-gray-500">Or choose your language:</p>
        <div class="flex flex-wrap justify-center gap-2">
          {localeLinks.map((l) => (
            <a
              href={l.href}
              class="rounded-md border border-gray-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 transition-colors hover:border-gray-300 hover:bg-gray-50"
            >
              {l.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
