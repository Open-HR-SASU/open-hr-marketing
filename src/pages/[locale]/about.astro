---
/**
 * About Page
 *
 * CMS-powered page fetching content from Sanity.
 * Generates static pages for all 6 locales.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionsRenderer from '@/components/sections/SectionsRenderer.astro';
import { locales, type Locale } from '@/lib/i18n';
import { getPage, getPageMetadata } from '@/lib/sanity';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Fetch page content from Sanity
const page = await getPage('about', locale);
const metadata = await getPageMetadata('about', locale);

// Fallback content if CMS content not available
const fallbackTitle = {
  'fr': 'A propos - Open HR',
  'en-GB': 'About - Open HR',
  'en-US': 'About - Open HR',
  'de': 'Uber uns - Open HR',
  'es': 'Acerca de - Open HR',
  'it': 'Chi siamo - Open HR',
}[locale];

const fallbackDescription = {
  'fr': 'Decouvrez Open HR, l\'infrastructure RH de demain.',
  'en-GB': 'Discover Open HR, tomorrow\'s HR infrastructure.',
  'en-US': 'Discover Open HR, tomorrow\'s HR infrastructure.',
  'de': 'Entdecken Sie Open HR, die HR-Infrastruktur von morgen.',
  'es': 'Descubre Open HR, la infraestructura de RRHH del manana.',
  'it': 'Scopri Open HR, l\'infrastruttura HR di domani.',
}[locale];

const title = metadata?.seo?.metaTitle || metadata?.title || fallbackTitle;
const description = metadata?.seo?.metaDescription || fallbackDescription;
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
>
  {page?.sections && page.sections.length > 0 ? (
    <SectionsRenderer sections={page.sections} locale={locale} />
  ) : (
    <!-- Fallback content when CMS content unavailable -->
    <section class="container py-24">
      <div class="max-w-4xl mx-auto">
        <!-- Hero -->
        <div class="text-center mb-16">
          <h1 class="text-display-2 text-foreground mb-6">
            {locale === 'fr' ? 'À propos d\'Open HR' : locale === 'de' ? 'Über Open HR' : locale === 'es' ? 'Acerca de Open HR' : locale === 'it' ? 'Chi siamo' : 'About Open HR'}
          </h1>
          <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
            {locale === 'fr' ? 'RH pour tous. Une infrastructure d\'emploi qui met le pouvoir entre les mains des travailleurs.' :
             locale === 'de' ? 'HR für alle. Eine Beschäftigungsinfrastruktur, die Arbeitnehmern die Kontrolle gibt.' :
             locale === 'es' ? 'RRHH para todos. Una infraestructura de empleo que pone el poder en manos de los trabajadores.' :
             locale === 'it' ? 'HR per tutti. Un\'infrastruttura occupazionale che dà potere ai lavoratori.' :
             'HR for everyone. Employment infrastructure that puts power in the hands of workers.'}
          </p>
        </div>

        <!-- Mission -->
        <div class="mb-16">
          <h2 class="text-display-4 text-foreground mb-4 text-center">
            {locale === 'fr' ? 'Notre mission' : locale === 'de' ? 'Unsere Mission' : locale === 'es' ? 'Nuestra misión' : locale === 'it' ? 'La nostra missione' : 'Our mission'}
          </h2>
          <p class="text-body text-muted-foreground mb-4 text-center max-w-3xl mx-auto">
            {locale === 'fr' ? 'Donner à chaque professionnel un profil portable et vérifiable qui l\'accompagne tout au long de sa carrière.' :
             locale === 'de' ? 'Jedem Fachmann ein tragbares und überprüfbares Profil geben, das ihn während seiner gesamten Karriere begleitet.' :
             locale === 'es' ? 'Dar a cada profesional un perfil portable y verificable que lo acompañe a lo largo de su carrera.' :
             locale === 'it' ? 'Dare a ogni professionista un profilo portatile e verificabile che lo accompagni per tutta la carriera.' :
             'Give every professional a portable, verifiable profile that follows them throughout their career.'}
          </p>
          <p class="text-body text-muted-foreground text-center max-w-3xl mx-auto">
            {locale === 'fr' ? 'Chez Open HR, nous croyons que votre parcours professionnel vous appartient. Les entretiens structurés et les références vérifiées ne devraient pas disparaître après chaque recrutement.' :
             locale === 'de' ? 'Bei Open HR glauben wir, dass Ihr beruflicher Werdegang Ihnen gehört. Strukturierte Interviews und verifizierte Referenzen sollten nicht nach jeder Einstellung verschwinden.' :
             locale === 'es' ? 'En Open HR, creemos que tu trayectoria profesional te pertenece. Las entrevistas estructuradas y las referencias verificadas no deberían desaparecer después de cada contratación.' :
             locale === 'it' ? 'In Open HR, crediamo che il tuo percorso professionale ti appartenga. I colloqui strutturati e i riferimenti verificati non dovrebbero scomparire dopo ogni assunzione.' :
             'At Open HR, we believe your professional journey belongs to you. Structured interviews and verified references shouldn\'t disappear after each hire.'}
          </p>
        </div>

        <!-- Values (aligned with Brand Strategy Document v1.0) -->
        <div class="mb-16">
          <h2 class="text-display-4 text-foreground mb-4 text-center">
            {locale === 'fr' ? 'Nos valeurs' : locale === 'de' ? 'Unsere Werte' : locale === 'es' ? 'Nuestros valores' : locale === 'it' ? 'I nostri valori' : 'Our values'}
          </h2>
          <p class="text-muted-foreground text-center mb-8">
            {locale === 'fr' ? 'Les principes qui guident notre action' : locale === 'de' ? 'Die Prinzipien, die unser Handeln leiten' : locale === 'es' ? 'Los principios que guían nuestra acción' : locale === 'it' ? 'I principi che guidano la nostra azione' : 'The principles that guide our actions'}
          </p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Scientific Rigor -->
            <div class="p-6 bg-surface rounded-lg border border-border text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-openhr-teal-900/10 text-openhr-teal-900">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-foreground mb-2">
                {locale === 'fr' ? 'Rigueur scientifique' : locale === 'de' ? 'Wissenschaftliche Strenge' : locale === 'es' ? 'Rigor científico' : locale === 'it' ? 'Rigore scientifico' : 'Scientific Rigor'}
              </h3>
              <p class="text-muted-foreground text-sm">
                {locale === 'fr' ? 'Nos décisions sont fondées sur la psychologie I-O et la recherche, pas sur l\'intuition.' :
                 locale === 'de' ? 'Unsere Entscheidungen basieren auf I-O-Psychologie und Forschung, nicht auf Bauchgefühl.' :
                 locale === 'es' ? 'Nuestras decisiones se basan en la psicología I-O y la investigación, no en la intuición.' :
                 locale === 'it' ? 'Le nostre decisioni sono basate sulla psicologia I-O e sulla ricerca, non sull\'intuito.' :
                 'Our decisions are grounded in I-O Psychology and research, not gut feel.'}
              </p>
            </div>
            <!-- Transparency = Empowerment -->
            <div class="p-6 bg-surface rounded-lg border border-border text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-openhr-teal-900/10 text-openhr-teal-900">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-foreground mb-2">
                {locale === 'fr' ? 'Transparence = Autonomisation' : locale === 'de' ? 'Transparenz = Ermächtigung' : locale === 'es' ? 'Transparencia = Empoderamiento' : locale === 'it' ? 'Trasparenza = Empowerment' : 'Transparency = Empowerment'}
              </h3>
              <p class="text-muted-foreground text-sm">
                {locale === 'fr' ? 'L\'accès aux données supprime les inégalités. Votre réputation, vos données.' :
                 locale === 'de' ? 'Datenzugang beseitigt Ungleichheiten. Ihr Ruf, Ihre Daten.' :
                 locale === 'es' ? 'El acceso a los datos elimina las desigualdades. Tu reputación, tus datos.' :
                 locale === 'it' ? 'L\'accesso ai dati elimina le disuguaglianze. La tua reputazione, i tuoi dati.' :
                 'Access to data removes inequality. Your reputation, your data.'}
              </p>
            </div>
            <!-- Privacy-First -->
            <div class="p-6 bg-surface rounded-lg border border-border text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-openhr-teal-900/10 text-openhr-teal-900">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-foreground mb-2">
                {locale === 'fr' ? 'Confidentialité d\'abord' : locale === 'de' ? 'Datenschutz zuerst' : locale === 'es' ? 'Privacidad primero' : locale === 'it' ? 'Privacy prima di tutto' : 'Privacy-First'}
              </h3>
              <p class="text-muted-foreground text-sm">
                {locale === 'fr' ? 'Vous possédez vos données. Point final. Nous ne les vendons jamais.' :
                 locale === 'de' ? 'Sie besitzen Ihre Daten. Punkt. Wir verkaufen sie niemals.' :
                 locale === 'es' ? 'Tus datos son tuyos. Punto. Nunca los vendemos.' :
                 locale === 'it' ? 'I tuoi dati sono tuoi. Punto. Non li vendiamo mai.' :
                 'You own your data. Period. We never sell it.'}
              </p>
            </div>
            <!-- Candidate Sovereignty -->
            <div class="p-6 bg-surface rounded-lg border border-border text-center">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-openhr-teal-900/10 text-openhr-teal-900">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-foreground mb-2">
                {locale === 'fr' ? 'Souveraineté du candidat' : locale === 'de' ? 'Bewerber-Souveränität' : locale === 'es' ? 'Soberanía del candidato' : locale === 'it' ? 'Sovranità del candidato' : 'Candidate Sovereignty'}
              </h3>
              <p class="text-muted-foreground text-sm">
                {locale === 'fr' ? 'Votre dignité en tant que travailleur est non négociable. Vous contrôlez qui voit votre profil.' :
                 locale === 'de' ? 'Ihre Würde als Arbeitnehmer ist nicht verhandelbar. Sie kontrollieren, wer Ihr Profil sieht.' :
                 locale === 'es' ? 'Tu dignidad como trabajador no es negociable. Tú controlas quién ve tu perfil.' :
                 locale === 'it' ? 'La tua dignità come lavoratore non è negoziabile. Tu controlli chi vede il tuo profilo.' :
                 'Your dignity as a worker is non-negotiable. You control who sees your profile.'}
              </p>
            </div>
            <!-- Small Players, Big Impact -->
            <div class="p-6 bg-surface rounded-lg border border-border text-center md:col-span-2 lg:col-span-1">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-openhr-teal-900/10 text-openhr-teal-900">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-foreground mb-2">
                {locale === 'fr' ? 'Petits acteurs, grand impact' : locale === 'de' ? 'Kleine Akteure, große Wirkung' : locale === 'es' ? 'Pequeños actores, gran impacto' : locale === 'it' ? 'Piccoli attori, grande impatto' : 'Small Players, Big Impact'}
              </h3>
              <p class="text-muted-foreground text-sm">
                {locale === 'fr' ? 'Plus de 90% des entreprises sont des PME. Pourquoi n\'auraient-elles pas accès aux meilleurs outils RH ?' :
                 locale === 'de' ? 'Über 90% der Unternehmen sind KMU. Warum sollten sie keinen Zugang zu den besten HR-Tools haben?' :
                 locale === 'es' ? 'Más del 90% de las empresas son PYMES. ¿Por qué no deberían tener acceso a las mejores herramientas de RRHH?' :
                 locale === 'it' ? 'Oltre il 90% delle aziende sono PMI. Perché non dovrebbero avere accesso ai migliori strumenti HR?' :
                 'Over 90% of businesses are SMEs. Why shouldn\'t they have access to cutting-edge HR tools?'}
              </p>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="text-center">
          <a href={`/${locale}/pilot/`} class="inline-flex items-center justify-center px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary/90 transition-colors">
            {locale === 'fr' ? 'Rejoindre le programme pilote' : locale === 'de' ? 'Pilotprogramm beitreten' : locale === 'es' ? 'Unirse al programa piloto' : locale === 'it' ? 'Unisciti al programma pilota' : 'Join the pilot program'}
          </a>
        </div>
      </div>
    </section>
  )}
</MainLayout>
