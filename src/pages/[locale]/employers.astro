---
/**
 * Employers Page — B2B Landing
 *
 * Per-assessment pricing for employers.
 * Platform endpoints already live at app.open-hr.work/employer/*.
 *
 * @see OPE-778 - Employer B2B Portal
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Mark from '@/components/Mark.astro';
import EmployerPricingSection from '@/components/islands/EmployerPricingSection';
import { locales, type Locale } from '@/lib/i18n';
import { generateBreadcrumbSchema } from '@/lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

const content: Record<Locale, {
