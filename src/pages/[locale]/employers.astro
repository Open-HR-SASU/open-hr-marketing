const t = content[locale];
const signupUrl = 'https://app.open-hr.work/employer/auth/signup';
const signinUrl = 'https://app.open-hr.work/employer/auth/login';

// Breadcrumb structured data
const breadcrumbNames: Record<Locale, string> = {
  'fr': 'Employeurs',
  'en-GB': 'Employers',
  'en-US': 'Employers',
  'de': 'Arbeitgeber',
  'es': 'Empleadores',
  'it': 'Datori di lavoro',
};
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Open HR', url: `/${locale}/` },
  { name: breadcrumbNames[locale], url: `/${locale}/employers/` },
]);
---

<MainLayout
  title={t.title}
  description={t.description}
  locale={locale}
  additionalSchemas={[breadcrumbSchema]}
  pagePath="/employers/"
>
  <!-- Hero -->
  <section class="container py-16 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-6 flex justify-center">
        <Mark size="lg" class="text-openhr-teal-900" />
      </div>
      <h1 class="mb-4 font-display text-4xl font-extrabold text-foreground md:text-5xl whitespace-pre-line">
        {t.heroHeading}
      </h1>
      <p class="mx-auto max-w-2xl text-xl text-gray-600">
        {t.heroSub}
      </p>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={signupUrl}
          class="btn btn-primary text-base px-8 py-3"
        >
          {t.heroCta}
        </a>
        <a
          href={signinUrl}
          class="btn btn-secondary text-base px-8 py-3"
        >
          {t.heroSignIn}
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="border-t border-gray-200 bg-gray-50">
    <div class="container py-16 md:py-24">
      <h2 class="mb-12 text-center font-display text-3xl font-bold text-foreground md:text-4xl">
        {t.howTitle}
      </h2>
      <div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-3">
        {t.steps.map((step, i) => (
          <div class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-openhr-teal-900 text-lg font-bold text-white">
              {i + 1}
            </div>
            <h3 class="mb-2 font-display text-lg font-semibold text-foreground">
              {step.title}
            </h3>
            <p class="text-sm text-gray-600">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="container py-16 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-4 font-display text-3xl font-bold text-foreground md:text-4xl">
        {t.pricingHeading}
      </h2>
      <p class="text-xl text-gray-600">
        {t.pricingSub}
      </p>
    </div>
    <EmployerPricingSection locale={locale} client:load />
  </section>

  <!-- Bottom CTA -->
  <section class="border-t border-gray-200 bg-openhr-teal-900">
    <div class="container py-16 md:py-20 text-center">
      <h2 class="mb-4 font-display text-3xl font-bold text-white md:text-4xl">
        {t.ctaHeading}
      </h2>
      <p class="mx-auto mb-8 max-w-xl text-lg text-openhr-teal-100">
        {t.ctaSub}
      </p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={signupUrl}
          class="inline-flex min-h-12 items-center rounded-md bg-white px-8 py-3 text-base font-medium text-openhr-teal-900 transition-colors hover:bg-openhr-teal-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-openhr-teal-900"
        >
          {t.ctaButton}
        </a>
        <a
          href={signinUrl}
          class="inline-flex min-h-12 items-center rounded-md border border-white/30 px-8 py-3 text-base font-medium text-white transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-openhr-teal-900"
        >
          {t.signInLabel} {t.signInNote}
        </a>
      </div>
    </div>
  </section>
</MainLayout>
