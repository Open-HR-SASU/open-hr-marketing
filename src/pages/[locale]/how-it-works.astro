---
/**
 * How It Works Page
 *
 * CMS-powered explainer page.
 * Generates static pages for all 6 locales.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionsRenderer from '@/components/sections/SectionsRenderer.astro';
import { locales, type Locale } from '@/lib/i18n';
import { getPage, getPageMetadata } from '@/lib/sanity';
import { generateHowToSchema, generateBreadcrumbSchema } from '@/lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Fetch page content from Sanity
const page = await getPage('how-it-works', locale);
const metadata = await getPageMetadata('how-it-works', locale);

// Fallback content
const fallbackTitle = {
  'fr': 'Comment ça marche - Open HR',
  'en-GB': 'How It Works - Open HR',
  'en-US': 'How It Works - Open HR',
  'de': 'So funktioniert es - Open HR',
  'es': 'Cómo funciona - Open HR',
  'it': 'Come funziona - Open HR',
}[locale];

const fallbackDescription = {
  'fr': 'Trois étapes pour obtenir une accréditation reconnue par les employeurs. Invitez vos références, elles répondent anonymement, vous recevez une note vérifiée.',
  'en-GB': 'Three steps to a credential employers trust. Invite references, they answer anonymously, you get a verified rating.',
  'en-US': 'Three steps to a credential employers trust. Invite references, they answer anonymously, you get a verified rating.',
  'de': 'Drei Schritte zu einer Akkreditierung, der Arbeitgeber vertrauen. Laden Sie Referenzen ein, sie antworten anonym, Sie erhalten eine verifizierte Bewertung.',
  'es': 'Tres pasos para una acreditación en la que confían los empleadores. Invita referencias, responden de forma anónima, obtienes una calificación verificada.',
  'it': 'Tre passaggi per una credenziale di cui i datori di lavoro si fidano. Invita referenze, rispondono in modo anonimo, ottieni una valutazione verificata.',
}[locale];

const title = metadata?.seo?.metaTitle || metadata?.title || fallbackTitle;
const description = metadata?.seo?.metaDescription || fallbackDescription;

// Structured data (OPE-698)
const howToSchema = generateHowToSchema(locale);

const breadcrumbNames: Record<Locale, string> = {
  'fr': 'Comment ça marche',
  'en-GB': 'How It Works',
  'en-US': 'How It Works',
  'de': 'So funktioniert es',
  'es': 'Cómo funciona',
  'it': 'Come funziona',
};
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Open HR', url: `/${locale}/` },
  { name: breadcrumbNames[locale], url: `/${locale}/how-it-works/` },
]);
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  additionalSchemas={[howToSchema, breadcrumbSchema]}
  pagePath="/how-it-works/"
>
  {page?.sections && page.sections.length > 0 ? (
    <SectionsRenderer sections={page.sections} locale={locale} />
  ) : (
    <section class="container py-24 text-center">
      <h1 class="text-display-2 text-foreground mb-6">
        {locale === 'fr' ? 'Comment ça marche' : 'How It Works'}
      </h1>
      <p class="text-body text-muted-foreground max-w-2xl mx-auto mb-8">
        {fallbackDescription}
      </p>
      <a href={`/${locale}/`} class="btn btn-primary">
        {locale === 'fr' ? 'Retour à l\'accueil' : 'Back to Home'}
      </a>
    </section>
  )}
</MainLayout>
