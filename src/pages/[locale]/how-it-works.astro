---
/**
 * How It Works Page
 *
 * CMS hero + React island toggle for Workers vs Employers process flows.
 * CMS CTA at the bottom.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionsRenderer from '@/components/sections/SectionsRenderer.astro';
import HowItWorksToggle from '@/components/islands/HowItWorksToggle';
import { locales, type Locale } from '@/lib/i18n';
import { getPage, getPageMetadata } from '@/lib/sanity';
import { generateHowToSchema, generateBreadcrumbSchema } from '@/lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Fetch page content from Sanity
const page = await getPage('how-it-works', locale);
const metadata = await getPageMetadata('how-it-works', locale);

// Separate hero and CTA sections from the process section
const heroSection = page?.sections?.find(s => s.sectionType === 'hero');
const ctaSection = page?.sections?.find(s => s.sectionType === 'cta');

// Fallback content
const fallbackTitle = {
  'fr': 'Comment ca marche - Open HR',
  'en-GB': 'How It Works - Open HR',
  'en-US': 'How It Works - Open HR',
  'de': 'So funktioniert es - Open HR',
  'es': 'Como funciona - Open HR',
  'it': 'Come funziona - Open HR',
}[locale];

const fallbackDescription = {
  'fr': 'Decouvrez comment Open HR fonctionne pour les travailleurs et les employeurs.',
  'en-GB': 'Discover how Open HR works for workers and employers.',
  'en-US': 'Discover how Open HR works for workers and employers.',
  'de': 'Erfahren Sie, wie Open HR fur Arbeitnehmer und Arbeitgeber funktioniert.',
  'es': 'Descubre como funciona Open HR para trabajadores y empleadores.',
  'it': 'Scopri come funziona Open HR per lavoratori e datori di lavoro.',
}[locale];

const title = metadata?.seo?.metaTitle || metadata?.title || fallbackTitle;
const description = metadata?.seo?.metaDescription || fallbackDescription;

// Structured data (OPE-698)
const howToSchema = generateHowToSchema(locale);

const breadcrumbNames: Record<Locale, string> = {
  'fr': 'Comment ca marche',
  'en-GB': 'How It Works',
  'en-US': 'How It Works',
  'de': 'So funktioniert es',
  'es': 'Como funciona',
  'it': 'Come funziona',
};
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Open HR', url: `/${locale}/` },
  { name: breadcrumbNames[locale], url: `/${locale}/how-it-works/` },
]);
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  additionalSchemas={[howToSchema, breadcrumbSchema]}
  pagePath="/how-it-works/"
>
  {/* CMS Hero Section */}
  {heroSection && (
    <SectionsRenderer sections={[heroSection]} locale={locale} />
  )}

  {/* Workers / Employers Toggle (React Island) */}
  <section class="container py-8 md:py-12">
    <HowItWorksToggle locale={locale} client:load />
  </section>

  {/* CMS CTA Section */}
  {ctaSection && (
    <SectionsRenderer sections={[ctaSection]} locale={locale} />
  )}
</MainLayout>
