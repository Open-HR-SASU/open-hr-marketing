---
/**
 * Homepage for each locale
 *
 * CMS-powered homepage with sections from Sanity.
 * Generates static pages for: /fr/, /en-GB/, /en-US/, /de/, /es/, /it/
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionsRenderer from '@/components/sections/SectionsRenderer.astro';
import { locales, type Locale } from '@/lib/i18n';
import { getPage, getPageMetadata } from '@/lib/sanity';
import { generateWebSiteSchema, generateServiceSchema } from '@/lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Fetch page content from Sanity
const page = await getPage('home', locale);
const metadata = await getPageMetadata('home', locale);

// Fallback content aligned with OPE-698 v2 value proposition
const fallbackTitle: Record<Locale, string> = {
  'fr': 'Open HR — Votre CV dit ce que vous avez fait. Nous prouvons comment vous l\'avez fait.',
  'en-GB': 'Open HR — Your CV says what you did. We prove how well you did it.',
  'en-US': 'Open HR — Your resume says what you did. We prove how well you did it.',
  'de': 'Open HR — Ihr Lebenslauf sagt, was Sie getan haben. Wir beweisen, wie gut Sie es getan haben.',
  'es': 'Open HR — Tu CV dice lo que hiciste. Nosotros demostramos lo bien que lo hiciste.',
  'it': 'Open HR — Il tuo CV dice cosa hai fatto. Noi dimostriamo quanto bene lo hai fatto.',
};

const fallbackDescription: Record<Locale, string> = {
  'fr': 'Construisez une accréditation vérifiée à partir de références anonymes. Joignez votre RefScore à vos candidatures, LinkedIn et plus encore.',
  'en-GB': 'Build a verified credential from anonymous references. Attach your RefScore to job applications, LinkedIn, and more.',
  'en-US': 'Build a verified credential from anonymous references. Attach your RefScore to job applications, LinkedIn, and more.',
  'de': 'Erstellen Sie eine verifizierte Akkreditierung aus anonymen Referenzen. Fügen Sie Ihren RefScore Bewerbungen, LinkedIn und mehr bei.',
  'es': 'Construye una acreditación verificada a partir de referencias anónimas. Adjunta tu RefScore a solicitudes de empleo, LinkedIn y más.',
  'it': 'Costruisci una credenziale verificata da referenze anonime. Allega il tuo RefScore alle candidature, LinkedIn e altro.',
};

const title = metadata?.seo?.metaTitle || metadata?.title || fallbackTitle[locale];
const description = metadata?.seo?.metaDescription || fallbackDescription[locale];

// Generate WebSite + Service schemas for homepage (OPE-421, AEO/GEO)
const webSiteSchema = generateWebSiteSchema(locale);
const serviceSchema = generateServiceSchema(locale);
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  additionalSchemas={[webSiteSchema, serviceSchema]}
  pagePath="/"
>
  {page?.sections && page.sections.length > 0 ? (
    <SectionsRenderer sections={page.sections} locale={locale} />
  ) : (
    <!-- Fallback Hero Section (when Sanity unavailable) -->
    <section class="container py-24 text-center">
      <p class="text-sm font-medium text-openhr-teal-900 mb-4">
        {locale === 'fr' ? 'Bientôt disponible' : 'Coming Soon'}
      </p>
      <h1 class="text-display-2 text-foreground mb-6">
        Open HR
      </h1>
      <p class="text-body text-muted-foreground max-w-2xl mx-auto mb-8">
        {fallbackDescription[locale]}
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href={`/${locale}/pilot/`} class="btn btn-primary">
          {locale === 'fr' ? 'Rejoindre le pilote' : 'Join the Pilot'}
        </a>
        <a href={`/${locale}/about/`} class="btn btn-secondary">
          {locale === 'fr' ? 'En savoir plus' : 'Learn More'}
        </a>
      </div>
    </section>
  )}
</MainLayout>
