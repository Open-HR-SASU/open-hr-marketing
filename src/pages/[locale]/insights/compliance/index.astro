---
/**
 * Compliance Briefs Listing Page
 *
 * Route: /[locale]/insights/compliance/
 * @see OPE-767
 */

import MainLayout from '@/layouts/MainLayout.astro';
import InsightCard from '@/components/insights/InsightCard.astro';
import { locales, type Locale, getSeriesLabels } from '@/lib/i18n';
import { getArticlesBySeries } from '@/lib/sanity';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const labels = getSeriesLabels('compliance', locale);
const articles = await getArticlesBySeries(locale, 'compliance');

const title = `${labels.heading} — Open HR`;
const description = labels.subheading;
---

<MainLayout title={title} description={description} locale={locale}>
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="mx-auto mb-4 max-w-2xl text-center">
        <a
          href={`/${locale}/insights/`}
          class="mb-6 inline-flex items-center text-sm text-gray-500 hover:text-openhr-teal-900"
        >
          {labels.backToInsights}
        </a>
      </div>

      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h1 class="mb-4 font-display text-display-2 font-extrabold text-foreground md:text-display-1">
          {labels.heading}
        </h1>
        <p class="text-lg text-gray-600">
          {labels.subheading}
        </p>
      </div>

      {articles.length > 0 ? (
        <ul class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {articles.map((article) => (
            <li>
              <InsightCard article={article} locale={locale} seriesSlug="compliance" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-center text-gray-500">{labels.noArticles}</p>
      )}
    </div>
  </section>
</MainLayout>
