---
/**
 * Glossary Entry Detail Page
 *
 * Renders a glossary entry with DefinedTerm JSON-LD.
 * Route: /[locale]/insights/glossary/[slug]/
 *
 * @see OPE-767
 */

import MainLayout from '@/layouts/MainLayout.astro';
import { RichText } from '@/components/sections/RichText';
import { locales, type Locale, getInsightLabels, getSeriesLabels } from '@/lib/i18n';
import { estimateReadingTime } from '@/lib/utils/readingTime';
import { getArticleSlugsBySeries, getArticle } from '@/lib/sanity';
import {
  generateArticleSchema,
  generateDefinedTermSchema,
  generateFAQPageSchema,
  generateBreadcrumbSchema,
  type Schema,
} from '@/lib/seo';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    try {
      const slugs = await getArticleSlugsBySeries(locale, 'glossary');
      for (const { slug } of slugs) {
        paths.push({ params: { locale, slug } });
      }
    } catch {
      // Sanity unavailable at build time
    }
  }
  return paths;
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const labels = getInsightLabels(locale);
const seriesLabels = getSeriesLabels('glossary', locale);
const article = await getArticle(slug, locale);

if (!article) {
  return new Response(null, { status: 404 });
}

const title = article.seo?.metaTitle || `${article.title} — Open HR`;
const description = article.seo?.metaDescription || article.excerpt;
const ogImage = article.seo?.ogImage?.asset?.url || article.coverImage?.asset?.url;
const coverUrl = article.coverImage?.asset?.url;
const lqip = article.coverImage?.asset?.metadata?.lqip;

const publishedDate = article.publishedAt
  ? new Intl.DateTimeFormat(locale === 'fr' ? 'fr-FR' : locale, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(new Date(article.publishedAt))
  : null;

const readingTime = article.body ? estimateReadingTime(article.body) : null;

const seriesHref = `/${locale}/insights/glossary/`;
const insightsHref = `/${locale}/insights/`;

// JSON-LD
const schemas: Schema[] = [
  generateDefinedTermSchema({
    term: article.title,
    definition: article.tldr || article.excerpt,
    locale,
    slug,
  }),
  generateArticleSchema({
    headline: article.title,
    description: article.excerpt,
    datePublished: article.publishedAt,
    image: coverUrl,
    authorName: article.author?.name,
    authorRole: article.author?.role,
    authorUrl: `https://open-hr.work/${locale}/insights/`,
  }),
  generateBreadcrumbSchema([
    { name: 'Open HR', url: `/${locale}/` },
    { name: 'Insights', url: insightsHref },
    { name: seriesLabels.heading, url: seriesHref },
    { name: article.title, url: `/${locale}/insights/glossary/${slug}/` },
  ]),
];

if (article.faq && article.faq.length > 0) {
  schemas.push(generateFAQPageSchema(article.faq));
}
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  ogImage={ogImage}
  additionalSchemas={schemas}
  pagePath={`/insights/glossary/${slug}/`}
>
  <article class="pb-16 md:pb-24">
    <!-- Breadcrumb -->
    <div class="container mx-auto px-4 pt-8">
      <nav class="flex items-center gap-2 text-sm text-gray-500" aria-label="Breadcrumb">
        <a href={insightsHref} class="hover:text-openhr-teal-900">Insights</a>
        <span aria-hidden="true">/</span>
        <a href={seriesHref} class="hover:text-openhr-teal-900">{seriesLabels.heading}</a>
        <span aria-hidden="true">/</span>
        <span class="text-gray-700">{article.title}</span>
      </nav>
    </div>

    <!-- Header -->
    <header class="container mx-auto px-4 py-10 md:py-16">
      <div class="mx-auto max-w-3xl">
        <div class="mb-4 inline-flex items-center rounded-full bg-openhr-teal-900/10 px-3 py-1 text-xs font-semibold text-openhr-teal-900">
          {seriesLabels.badgeLabel}
        </div>
        <h1 class="mb-6 font-display text-3xl font-extrabold leading-tight text-foreground md:text-4xl lg:text-5xl">
          {article.title}
        </h1>

        <!-- Author + date -->
        <div class="mb-8 flex flex-wrap items-center gap-4">
          {article.author && (
            <div class="flex items-center gap-3">
              {article.author.photo?.asset?.url && (
                <img
                  src={article.author.photo.asset.url}
                  alt={article.author.name}
                  width={40}
                  height={40}
                  class="rounded-full object-cover"
                />
              )}
              <div>
                <p class="text-sm font-medium text-foreground">{article.author.name}</p>
                {article.author.role && (
                  <p class="text-xs text-gray-500">{article.author.role}</p>
                )}
              </div>
            </div>
          )}
          {publishedDate && (
            <div class="flex items-center gap-2 text-xs text-gray-500">
              <span class="text-gray-300">|</span>
              <span>{labels.publishedOn} {publishedDate}</span>
            </div>
          )}
          {readingTime && (
            <div class="flex items-center gap-2 text-xs text-gray-500">
              <span class="text-gray-300">|</span>
              <span>{readingTime} {labels.readingTime}</span>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Content body -->
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl">

        <!-- Definition block (TL;DR styled as definition) -->
        {article.tldr && (
          <aside class="mb-10 rounded-lg border-l-4 border-openhr-teal-900 bg-openhr-teal-900/5 p-5 md:p-6">
            <h2 class="mb-2 font-display text-sm font-bold uppercase tracking-wider text-openhr-teal-900">
              {seriesLabels.tldrLabel}
            </h2>
            <p class="leading-relaxed text-gray-700">{article.tldr}</p>
          </aside>
        )}

        <!-- Article body (Portable Text) -->
        <div class="article-body mb-12">
          <RichText content={article.body} className="prose-lg" />
        </div>

        <!-- Related pillar article -->
        {article.relatedPillar && (
          <aside class="mb-12 rounded-lg border border-gray-200 bg-white p-5">
            <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-gray-400">Related</p>
            <a
              href={`/${locale}/insights/${article.relatedPillar.slug}/`}
              class="font-display text-base font-bold text-openhr-teal-900 hover:underline"
            >
              {article.relatedPillar.title}
            </a>
          </aside>
        )}

        <!-- Related terms -->
        {article.relatedArticles && article.relatedArticles.length > 0 && (
          <aside class="mb-12 rounded-xl border border-gray-200 bg-gray-50 p-6">
            <h2 class="mb-4 font-display text-sm font-bold uppercase tracking-wider text-gray-400">
              {labels.relatedTermsHeading}
            </h2>
            <div class="flex flex-wrap gap-2">
              {article.relatedArticles.map((related) => (
                <a
                  href={`/${locale}/insights/${related.seriesType === 'glossary' ? 'glossary/' : ''}${related.slug}/`}
                  class="rounded-full bg-openhr-teal-900/10 px-3 py-1 text-sm text-openhr-teal-900 transition-colors hover:bg-openhr-teal-900/20"
                >
                  {related.title}
                </a>
              ))}
            </div>
          </aside>
        )}

        <!-- FAQ Section -->
        {article.faq && article.faq.length > 0 && (
          <section class="mb-12 rounded-xl border border-gray-200 bg-gray-50 p-6 md:p-8">
            <h2 class="mb-6 font-display text-xl font-bold text-foreground">
              {labels.faqHeading}
            </h2>
            <dl class="space-y-6">
              {article.faq.map((item) => (
                <div>
                  <dt class="mb-2 font-display text-base font-semibold text-foreground">
                    {item.question}
                  </dt>
                  <dd class="leading-relaxed text-gray-600">
                    {item.answer}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <!-- Academic References -->
        {article.references && article.references.length > 0 && (
          <section class="mb-12">
            <h2 class="mb-4 font-display text-xl font-bold text-foreground">
              {labels.referencesHeading}
            </h2>
            <ol class="space-y-3 text-sm leading-relaxed text-gray-600">
              {article.references.map((ref) => (
                <li class="pl-4 -indent-4">
                  {ref.doi ? (
                    <a href={ref.doi} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-openhr-teal-700 hover:underline">
                      {ref.text}
                      <span class="ml-1.5 inline-flex items-center rounded bg-openhr-teal-900/10 px-1.5 py-0.5 align-middle font-mono text-[10px] uppercase tracking-wider text-openhr-teal-900">DOI</span>
                    </a>
                  ) : (
                    <span>{ref.text}</span>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )}

        <!-- Author bio -->
        {article.author?.bio && (
          <aside class="rounded-xl border border-gray-200 bg-white p-6">
            <h2 class="mb-4 font-display text-sm font-bold uppercase tracking-wider text-gray-400">
              {labels.aboutTheAuthor}
            </h2>
            <div class="flex items-start gap-4">
              {article.author.photo?.asset?.url && (
                <img src={article.author.photo.asset.url} alt={article.author.name} width={64} height={64} class="rounded-full object-cover" />
              )}
              <div>
                <p class="font-display text-base font-bold text-foreground">{article.author.name}</p>
                {article.author.role && <p class="mb-2 text-sm text-openhr-teal-900">{article.author.role}</p>}
                <p class="text-sm leading-relaxed text-gray-600">{article.author.bio}</p>
              </div>
            </div>
          </aside>
        )}
      </div>
    </div>
  </article>
</MainLayout>
