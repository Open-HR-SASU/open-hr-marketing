---
/**
 * Insights Listing Page
 *
 * Lists all insight articles for the current locale.
 * Static generation — all articles fetched at build time from Sanity.
 *
 * Route: /[locale]/insights/
 */

import MainLayout from '@/layouts/MainLayout.astro';
import InsightCard from '@/components/insights/InsightCard.astro';
import { locales, type Locale, getInsightLabels } from '@/lib/i18n';
import { getArticles } from '@/lib/sanity';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const labels = getInsightLabels(locale);

const articles = await getArticles(locale);

const title = `${labels.insightsHeading} — Open HR`;
const description = labels.insightsSubheading;
---

<MainLayout title={title} description={description} locale={locale}>
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <!-- Page heading -->
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h1 class="mb-4 font-display text-display-2 font-extrabold text-foreground md:text-display-1">
          {labels.insightsHeading}
        </h1>
        <p class="text-lg text-gray-600">
          {labels.insightsSubheading}
        </p>
      </div>

      <!-- Article grid -->
      {articles.length > 0 ? (
        <ul class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {articles.map((article) => (
            <li>
              <InsightCard article={article} locale={locale} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-center text-gray-500">{labels.noArticles}</p>
      )}
    </div>
  </section>
</MainLayout>
