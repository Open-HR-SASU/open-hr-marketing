---
/**
 * Legal Pages (Catch-all Route)
 *
 * Handles all legal pages from Sanity CMS legalDocument type:
 * - /[locale]/legal/mentions-legales/
 * - /[locale]/legal/confidentialite/
 * - /[locale]/legal/cookies/
 * - etc.
 *
 * Falls back to legacy page type if legalDocument not found.
 *
 * @see legalDocument schema in studio/schemaTypes/legalDocument.ts
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionsRenderer from '@/components/sections/SectionsRenderer.astro';
import LegalDocumentRenderer from '@/components/legal/LegalDocumentRenderer.astro';
import { locales, type Locale, getLegalLabels } from '@/lib/i18n';
import { getPage, getPageMetadata, getLegalDocument, getLegalDocumentSlugs } from '@/lib/sanity';

export async function getStaticPaths() {
  const paths = [];

  // Fetch legal document slugs for each locale
  for (const locale of locales) {
    try {
      const legalDocs = await getLegalDocumentSlugs(locale);
      for (const doc of legalDocs) {
        paths.push({
          params: { locale, slug: doc.slug },
          props: { documentType: doc.documentType },
        });
      }
    } catch {
      // If Sanity query fails, fall back to static slugs
    }
  }

  // Also add legacy slugs for backwards compatibility
  const legacySlugs = ['privacy', 'terms', 'cookies', 'refscore'];
  for (const locale of locales) {
    for (const slug of legacySlugs) {
      // Check if this slug is already added from Sanity
      const exists = paths.some(
        (p) => p.params.locale === locale && p.params.slug === slug
      );
      if (!exists) {
        paths.push({
          params: { locale, slug },
          props: { documentType: null },
        });
      }
    }
  }

  return paths;
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const labels = getLegalLabels(locale);

// Try to fetch from new legalDocument type first
const legalDocument = await getLegalDocument(slug, locale);

// Fall back to legacy page type if not found
let legacyPage = null;
let legacyMetadata = null;

if (!legalDocument) {
  // Try legacy page lookups
  const sanitySlug = `legal/${slug}`;
  legacyPage = await getPage(sanitySlug, locale) || await getPage(slug, locale);
  legacyMetadata = await getPageMetadata(sanitySlug, locale) || await getPageMetadata(slug, locale);
}

// Fallback titles for legacy pages (i18n tagged)
const fallbackTitles: Record<string, Record<Locale, string>> = {
  privacy: {
    'fr': 'Politique de confidentialite - Open HR',
    'en-GB': 'Privacy Policy - Open HR',
    'en-US': 'Privacy Policy - Open HR',
    'de': 'Datenschutzrichtlinie - Open HR',
    'es': 'Politica de privacidad - Open HR',
    'it': 'Informativa sulla privacy - Open HR',
  },
  terms: {
    'fr': 'Conditions d\'utilisation - Open HR',
    'en-GB': 'Terms of Service - Open HR',
    'en-US': 'Terms of Service - Open HR',
    'de': 'Nutzungsbedingungen - Open HR',
    'es': 'Terminos de servicio - Open HR',
    'it': 'Termini di servizio - Open HR',
  },
  cookies: {
    'fr': 'Politique de cookies - Open HR',
    'en-GB': 'Cookie Policy - Open HR',
    'en-US': 'Cookie Policy - Open HR',
    'de': 'Cookie-Richtlinie - Open HR',
    'es': 'Politica de cookies - Open HR',
    'it': 'Informativa sui cookie - Open HR',
  },
  refscore: {
    'fr': 'RefScore - Open HR',
    'en-GB': 'RefScore - Open HR',
    'en-US': 'RefScore - Open HR',
    'de': 'RefScore - Open HR',
    'es': 'RefScore - Open HR',
    'it': 'RefScore - Open HR',
  },
  'mentions-legales': {
    'fr': 'Mentions Legales - Open HR',
    'en-GB': 'Legal Notice - Open HR',
    'en-US': 'Legal Notice - Open HR',
    'de': 'Impressum - Open HR',
    'es': 'Aviso Legal - Open HR',
    'it': 'Note Legali - Open HR',
  },
  'confidentialite': {
    'fr': 'Politique de Confidentialite - Open HR',
    'en-GB': 'Privacy Policy - Open HR',
    'en-US': 'Privacy Policy - Open HR',
    'de': 'Datenschutzrichtlinie - Open HR',
    'es': 'Politica de Privacidad - Open HR',
    'it': 'Informativa sulla Privacy - Open HR',
  },
};

const fallbackHeadings: Record<string, Record<Locale, string>> = {
  privacy: {
    'fr': 'Politique de confidentialite',
    'en-GB': 'Privacy Policy',
    'en-US': 'Privacy Policy',
    'de': 'Datenschutzrichtlinie',
    'es': 'Politica de privacidad',
    'it': 'Informativa sulla privacy',
  },
  terms: {
    'fr': 'Conditions d\'utilisation',
    'en-GB': 'Terms of Service',
    'en-US': 'Terms of Service',
    'de': 'Nutzungsbedingungen',
    'es': 'Terminos de servicio',
    'it': 'Termini di servizio',
  },
  cookies: {
    'fr': 'Politique de cookies',
    'en-GB': 'Cookie Policy',
    'en-US': 'Cookie Policy',
    'de': 'Cookie-Richtlinie',
    'es': 'Politica de cookies',
    'it': 'Informativa sui cookie',
  },
  refscore: {
    'fr': 'RefScore Methodologie',
    'en-GB': 'RefScore Methodology',
    'en-US': 'RefScore Methodology',
    'de': 'RefScore Methodik',
    'es': 'Metodologia RefScore',
    'it': 'Metodologia RefScore',
  },
  'mentions-legales': {
    'fr': 'Mentions Legales',
    'en-GB': 'Legal Notice',
    'en-US': 'Legal Notice',
    'de': 'Impressum',
    'es': 'Aviso Legal',
    'it': 'Note Legali',
  },
  'confidentialite': {
    'fr': 'Politique de Confidentialite',
    'en-GB': 'Privacy Policy',
    'en-US': 'Privacy Policy',
    'de': 'Datenschutzrichtlinie',
    'es': 'Politica de Privacidad',
    'it': 'Informativa sulla Privacy',
  },
};

// Determine page metadata
let title: string;
let description: string;
let noIndex = false;

if (legalDocument) {
  // Use legalDocument metadata
  title = legalDocument.seo?.metaTitle || legalDocument.title;
  description = legalDocument.seo?.metaDescription || `${legalDocument.title} - Open HR`;
  noIndex = legalDocument.seo?.noIndex ?? false;
} else if (legacyMetadata) {
  // Use legacy page metadata
  title = legacyMetadata.seo?.metaTitle || legacyMetadata.title || fallbackTitles[slug]?.[locale] || `${slug} - Open HR`;
  description = legacyMetadata.seo?.metaDescription || `${fallbackHeadings[slug]?.[locale] || slug} - Open HR`;
} else {
  // Use fallbacks
  title = fallbackTitles[slug]?.[locale] || `${slug} - Open HR`;
  description = `${fallbackHeadings[slug]?.[locale] || slug} - Open HR`;
}

const heading = fallbackHeadings[slug]?.[locale] || slug;
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  noIndex={noIndex}
>
  {legalDocument ? (
    <!-- New legalDocument type with progressive disclosure -->
    <LegalDocumentRenderer document={legalDocument} locale={locale} />
  ) : legacyPage?.sections && legacyPage.sections.length > 0 ? (
    <!-- Legacy page type -->
    <SectionsRenderer sections={legacyPage.sections} locale={locale} />
  ) : (
    <!-- Fallback content when CMS content unavailable -->
    <section class="container py-16 md:py-24">
      <div class="mx-auto max-w-4xl">
        <h1 class="mb-8 font-display text-4xl font-bold text-foreground md:text-5xl">
          {heading}
        </h1>
        <div class="prose prose-lg max-w-none">
          <p class="text-gray-600">
            {labels.contentUnavailable}
          </p>
          <p class="mt-4">
            <a href={`/${locale}/`} class="text-openhr-teal-900 hover:text-openhr-teal-700">
              {labels.backToHome}
            </a>
          </p>
        </div>
      </div>
    </section>
  )}
</MainLayout>
