---
/**
 * Login Page
 *
 * Authentication entry point for Open HR.
 * Uses React island for interactive login form.
 *
 * @see OPE-432 - Fix app.open-hr.work/login 404
 */
import Layout from '@/layouts/Layout.astro';
import Mark from '@/components/Mark.astro';
import { LoginForm } from '@/components/islands/LoginForm';
import { locales, type Locale } from '@/lib/i18n';

export async function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Get callback URL from query params if present
const callbackUrl = Astro.url.searchParams.get('callbackUrl') || undefined;

// Page metadata per locale
const pageMeta: Record<Locale, { title: string; description: string }> = {
  fr: {
    title: 'Connexion | Open HR',
    description: 'Connectez-vous a votre compte Open HR',
  },
  'en-GB': {
    title: 'Sign In | Open HR',
    description: 'Sign in to your Open HR account',
  },
  'en-US': {
    title: 'Sign In | Open HR',
    description: 'Sign in to your Open HR account',
  },
  de: {
    title: 'Anmelden | Open HR',
    description: 'Melden Sie sich bei Ihrem Open HR-Konto an',
  },
  es: {
    title: 'Iniciar sesion | Open HR',
    description: 'Inicia sesion en tu cuenta de Open HR',
  },
  it: {
    title: 'Accedi | Open HR',
    description: 'Accedi al tuo account Open HR',
  },
};

const meta = pageMeta[locale] || pageMeta['en-US'];

// Quote translations
const quotes: Record<Locale, { text: string; author: string }> = {
  fr: {
    text: 'Votre reputation professionnelle verifiee, accessible partout ou vous allez.',
    author: 'Open HR, RH pour tous',
  },
  'en-GB': {
    text: 'Your verified professional reputation, accessible wherever you go.',
    author: 'Open HR, HR for everyone',
  },
  'en-US': {
    text: 'Your verified professional reputation, accessible wherever you go.',
    author: 'Open HR, HR for everyone',
  },
  de: {
    text: 'Ihre verifizierte berufliche Reputation, uberall verfugbar.',
    author: 'Open HR, HR fur alle',
  },
  es: {
    text: 'Tu reputacion profesional verificada, accesible donde vayas.',
    author: 'Open HR, RRHH para todos',
  },
  it: {
    text: 'La tua reputazione professionale verificata, accessibile ovunque tu vada.',
    author: 'Open HR, HR per tutti',
  },
};

const quote = quotes[locale] || quotes['en-US'];
---

<Layout
  title={meta.title}
  description={meta.description}
  locale={locale}
  noIndex={true}
>
  <div class="min-h-screen flex">
    <!-- Left Panel - Image (hidden on mobile) -->
    <div class="hidden lg:flex lg:w-1/2 relative bg-openhr-teal-900">
      <img
        src="/images/auth/login.jpg"
        alt=""
        class="absolute inset-0 w-full h-full object-cover opacity-80"
        loading="eager"
      />
      <!-- Overlay with brand message -->
      <div class="absolute inset-0 bg-gradient-to-t from-openhr-teal-900/90 via-openhr-teal-900/50 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-12 text-white">
        <blockquote class="space-y-4">
          <p class="text-xl font-medium leading-relaxed">
            "{quote.text}"
          </p>
          <footer class="text-openhr-teal-100 text-sm">
            - {quote.author}
          </footer>
        </blockquote>
      </div>
    </div>

    <!-- Right Panel - Form -->
    <div class="flex-1 flex flex-col bg-gray-50">
      <!-- Header -->
      <header class="pt-8 pb-4 px-6 lg:pt-12 lg:pb-6">
        <a
          href={`/${locale}/`}
          class="inline-flex items-center gap-3 text-openhr-teal-900 hover:text-openhr-teal-700 transition-colors"
        >
          <Mark size="lg" />
          <span class="font-display font-semibold text-lg tracking-tight">
            Open HR
          </span>
        </a>
      </header>

      <!-- Content -->
      <main id="main-content" class="flex-1 flex items-center justify-center px-6 py-8">
        <div class="w-full max-w-md">
          <LoginForm client:load locale={locale} callbackUrl={callbackUrl} />
        </div>
      </main>

      <!-- Footer -->
      <footer class="py-6 px-6 text-center text-sm text-gray-500">
        <p>
          &copy; {new Date().getFullYear()} Open HR - RH pour tous
        </p>
      </footer>
    </div>
  </div>
</Layout>
