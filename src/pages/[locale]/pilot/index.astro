---
/**
 * Pilot Signup Page
 *
 * Updated 2026-03-15: Workers are free. Always.
 * No more founding member pricing — signup is free.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Mark from '@/components/Mark.astro';
import PilotSignupForm from '@/components/islands/PilotSignupForm';
import { locales, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

const content = {
  fr: {
    title: 'Obtenez votre RefScore - Open HR',
    description: 'Inscrivez-vous gratuitement et obtenez votre RefScore. Gratuit pour les travailleurs. Toujours.',
    heading: 'Obtenez votre RefScore',
    subheading: 'Gratuit pour les travailleurs. Toujours.',
    intro: 'Votre RefScore est disponible maintenant. Inscrivez-vous et construisez votre reputation professionnelle verifiee — sans frais, sans conditions.',
  },
  'en-GB': {
    title: 'Get Your RefScore - Open HR',
    description: 'Sign up for free and get your RefScore. Free for workers. Always.',
    heading: 'Get Your RefScore',
    subheading: 'Free for workers. Always.',
    intro: 'Your RefScore is available now. Sign up and build your verified professional reputation — no cost, no catch.',
  },
  'en-US': {
    title: 'Get Your RefScore - Open HR',
    description: 'Sign up for free and get your RefScore. Free for workers. Always.',
    heading: 'Get Your RefScore',
    subheading: 'Free for workers. Always.',
    intro: 'Your RefScore is available now. Sign up and build your verified professional reputation — no cost, no catch.',
  },
  de: {
    title: 'Holen Sie sich Ihren RefScore - Open HR',
    description: 'Melden Sie sich kostenlos an und erhalten Sie Ihren RefScore. Kostenlos fur Arbeitnehmer. Immer.',
    heading: 'Holen Sie sich Ihren RefScore',
    subheading: 'Kostenlos fur Arbeitnehmer. Immer.',
    intro: 'Ihr RefScore ist jetzt verfugbar. Melden Sie sich an und erstellen Sie Ihr verifiziertes Berufsprofil — ohne Kosten, ohne Bedingungen.',
  },
  es: {
    title: 'Obten tu RefScore - Open HR',
    description: 'Registrate gratis y obten tu RefScore. Gratis para trabajadores. Siempre.',
    heading: 'Obten tu RefScore',
    subheading: 'Gratis para trabajadores. Siempre.',
    intro: 'Tu RefScore ya esta disponible. Registrate y construye tu reputacion profesional verificada — sin coste, sin condiciones.',
  },
  it: {
    title: 'Ottieni il tuo RefScore - Open HR',
    description: 'Registrati gratuitamente e ottieni il tuo RefScore. Gratuito per i lavoratori. Sempre.',
    heading: 'Ottieni il tuo RefScore',
    subheading: 'Gratuito per i lavoratori. Sempre.',
    intro: 'Il tuo RefScore e disponibile ora. Registrati e costruisci la tua reputazione professionale verificata — senza costi, senza condizioni.',
  },
}[locale];
---

<MainLayout
  title={content.title}
  description={content.description}
  locale={locale}
>
  <section class="container py-16 md:py-24">
    <div class="mx-auto max-w-2xl">
      <!-- Header with Mark -->
      <div class="mb-12 text-center">
        <div class="mb-6 flex justify-center">
          <Mark size="xl" class="text-openhr-teal-900" />
        </div>
        <h1 class="mb-4 font-display text-4xl font-extrabold text-foreground md:text-5xl">
          {content.heading}
        </h1>
        <p class="text-xl text-gray-600">
          {content.subheading}
        </p>
      </div>

      <!-- Intro text -->
      <p class="mb-12 text-center text-lg text-gray-600">
        {content.intro}
      </p>

      <!-- Signup Form (React Island) -->
      <div class="rounded-xl bg-white p-8 shadow-lg">
        <PilotSignupForm locale={locale} client:load />
      </div>
    </div>
  </section>
</MainLayout>
