---
/**
 * Pilot Signup Page
 *
 * CRITICAL PATH: Must be live before Feb 6, 2026 announcement.
 *
 * Features:
 * - React island form (PilotSignupForm) with client:load
 * - POSTs to platform API (https://app.open-hr.work/api/pilot/signup)
 * - Localized content for all 6 locales
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Mark from '@/components/Mark.astro';
import PilotSignupForm from '@/components/islands/PilotSignupForm';
import { locales, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Localized content — OPE-719 (2026-02-25): updated for annual pricing pivot (DL-34)
// Removed stale "February 2026" launch date references; aligned with Founding Member framing
const content = {
  fr: {
    title: 'Obtenez votre RefScore - Open HR',
    description: 'Rejoignez les 100 premiers membres fondateurs d\'Open HR. Accès annuel complet à partir de 12 €/an.',
    heading: 'Membre Fondateur',
    subheading: 'Obtenez votre RefScore. Verrouillez votre tarif fondateur.',
    intro: 'Votre RefScore est disponible maintenant. Rejoignez les 100 premiers membres fondateurs à 12 €/an — moins d\'1 €/mois.',
  },
  'en-GB': {
    title: 'Get Your RefScore - Open HR',
    description: 'Join the first 100 founding members of Open HR. Full annual access from £10/year.',
    heading: 'Founding Member',
    subheading: 'Get Your RefScore. Lock in your founding rate.',
    intro: 'Your RefScore is available now. Join the first 100 founding members for £10/year — less than £1/month.',
  },
  'en-US': {
    title: 'Get Your RefScore - Open HR',
    description: 'Join the first 100 founding members of Open HR. Full annual access from $12/year.',
    heading: 'Founding Member',
    subheading: 'Get Your RefScore. Lock in your founding rate.',
    intro: 'Your RefScore is available now. Join the first 100 founding members for $12/year — less than $1/month.',
  },
  de: {
    title: 'Holen Sie sich Ihren RefScore - Open HR',
    description: 'Werden Sie eines der ersten 100 Gründungsmitglieder von Open HR. Vollständiger Jahreszugang ab 12 €/Jahr.',
    heading: 'Gründungsmitglied',
    subheading: 'Holen Sie sich Ihren RefScore. Sichern Sie sich Ihren Gründungspreis.',
    intro: 'Ihr RefScore ist jetzt verfügbar. Werden Sie eines der ersten 100 Gründungsmitglieder für 12 €/Jahr — weniger als 1 €/Monat.',
  },
  es: {
    title: 'Obtén tu RefScore - Open HR',
    description: 'Únete a los primeros 100 miembros fundadores de Open HR. Acceso anual completo desde 12 €/año.',
    heading: 'Miembro Fundador',
    subheading: 'Obtén tu RefScore. Bloquea tu tarifa de fundador.',
    intro: 'Tu RefScore ya está disponible. Únete a los primeros 100 miembros fundadores por 12 €/año — menos de 1 €/mes.',
  },
  it: {
    title: 'Ottieni il tuo RefScore - Open HR',
    description: 'Unisciti ai primi 100 membri fondatori di Open HR. Accesso annuale completo da 12 €/anno.',
    heading: 'Membro Fondatore',
    subheading: 'Ottieni il tuo RefScore. Blocca la tariffa fondatore.',
    intro: 'Il tuo RefScore è disponibile ora. Unisciti ai primi 100 membri fondatori per 12 €/anno — meno di 1 €/mese.',
  },
}[locale];
---

<MainLayout
  title={content.title}
  description={content.description}
  locale={locale}
>
  <section class="container py-16 md:py-24">
    <div class="mx-auto max-w-2xl">
      <!-- Header with Mark -->
      <div class="mb-12 text-center">
        <div class="mb-6 flex justify-center">
          <Mark size="xl" class="text-openhr-teal-900" />
        </div>
        <h1 class="mb-4 font-display text-4xl font-extrabold text-foreground md:text-5xl">
          {content.heading}
        </h1>
        <p class="text-xl text-gray-600">
          {content.subheading}
        </p>
      </div>

      <!-- Intro text -->
      <p class="mb-12 text-center text-lg text-gray-600">
        {content.intro}
      </p>

      <!-- Signup Form (React Island) -->
      <div class="rounded-xl bg-white p-8 shadow-lg">
        <PilotSignupForm locale={locale} client:load />
      </div>
    </div>
  </section>
</MainLayout>
