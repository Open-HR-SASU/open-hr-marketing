---
/**
 * Pilot Signup Page
 *
 * CRITICAL PATH: Must be live before Feb 6, 2026 announcement.
 *
 * Features:
 * - React island form (PilotSignupForm) with client:load
 * - POSTs to platform API (https://app.open-hr.work/api/pilot/signup)
 * - Localized content for all 6 locales
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Mark from '@/components/Mark.astro';
import PilotSignupForm from '@/components/islands/PilotSignupForm';
import { locales, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Localized content
const content = {
  fr: {
    title: 'Rejoignez le pilote - Open HR',
    description: 'Soyez parmi les premiers a decouvrir Open HR. Inscrivez-vous au programme pilote.',
    heading: 'Pilote',
    subheading: 'L\'infrastructure RH de demain commence ici.',
    intro: 'Nous lancons notre programme pilote en fevrier 2026. Les places sont limitees. Inscrivez-vous pour etre parmi les premiers a decouvrir Open HR.',
  },
  'en-GB': {
    title: 'Join the Pilot - Open HR',
    description: 'Be among the first to discover Open HR. Sign up for the pilot programme.',
    heading: 'Pilot',
    subheading: 'Tomorrow\'s HR infrastructure starts here.',
    intro: 'We are launching our pilot programme in February 2026. Places are limited. Sign up to be among the first to discover Open HR.',
  },
  'en-US': {
    title: 'Join the Pilot - Open HR',
    description: 'Be among the first to discover Open HR. Sign up for the pilot program.',
    heading: 'Pilot',
    subheading: 'Tomorrow\'s HR infrastructure starts here.',
    intro: 'We are launching our pilot program in February 2026. Places are limited. Sign up to be among the first to discover Open HR.',
  },
  de: {
    title: 'Am Pilotprogramm teilnehmen - Open HR',
    description: 'Gehoren Sie zu den Ersten, die Open HR entdecken. Melden Sie sich fur das Pilotprogramm an.',
    heading: 'Pilotprogramm',
    subheading: 'Die HR-Infrastruktur von morgen beginnt hier.',
    intro: 'Wir starten unser Pilotprogramm im Februar 2026. Die Platze sind begrenzt. Melden Sie sich an, um zu den Ersten zu gehoren, die Open HR entdecken.',
  },
  es: {
    title: 'Unete al piloto - Open HR',
    description: 'Se de los primeros en descubrir Open HR. Inscribete en el programa piloto.',
    heading: 'Piloto',
    subheading: 'La infraestructura de RRHH del manana comienza aqui.',
    intro: 'Lanzamos nuestro programa piloto en febrero de 2026. Los lugares son limitados. Inscribete para estar entre los primeros en descubrir Open HR.',
  },
  it: {
    title: 'Unisciti al pilota - Open HR',
    description: 'Sii tra i primi a scoprire Open HR. Iscriviti al programma pilota.',
    heading: 'Pilota',
    subheading: 'L\'infrastruttura HR di domani inizia qui.',
    intro: 'Lanciamo il nostro programma pilota a febbraio 2026. I posti sono limitati. Iscriviti per essere tra i primi a scoprire Open HR.',
  },
}[locale];
---

<MainLayout
  title={content.title}
  description={content.description}
  locale={locale}
>
  <section class="container py-16 md:py-24">
    <div class="mx-auto max-w-2xl">
      <!-- Header with Mark -->
      <div class="mb-12 text-center">
        <div class="mb-6 flex justify-center">
          <Mark size="xl" class="text-openhr-teal-900" />
        </div>
        <h1 class="mb-4 font-display text-4xl font-extrabold text-foreground md:text-5xl">
          {content.heading}
        </h1>
        <p class="text-xl text-gray-600">
          {content.subheading}
        </p>
      </div>

      <!-- Intro text -->
      <p class="mb-12 text-center text-lg text-gray-600">
        {content.intro}
      </p>

      <!-- Signup Form (React Island) -->
      <div class="rounded-xl bg-white p-8 shadow-lg">
        <PilotSignupForm locale={locale} client:load />
      </div>
    </div>
  </section>
</MainLayout>
