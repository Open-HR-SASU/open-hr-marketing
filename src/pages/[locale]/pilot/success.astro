    collapseLabel: 'Reduire',
    backHome: 'Retour a l\'accueil',
  },
  'en-GB': {
    title: 'Registration Confirmed - Open HR',
    description: 'Your Open HR pilot programme registration has been confirmed. Discover what happens next.',
    congratsHeading: userName ? `Congratulations, ${userName}!` : 'Congratulations!',
    congratsSubheading: 'You are part of the Open HR pilot.',
    congratsMessage: 'Thank you for joining us. You are about to be part of the professional references revolution.',
