---

<MainLayout
  title={content.title}
  description={content.description}
  locale={locale}
>
  <section class="container py-16 md:py-24">
    <div class="mx-auto max-w-2xl">
      <!-- Congratulations Section -->
      <div class="mb-12 text-center">
        <!-- Success Icon -->
        <div class="mb-6 flex justify-center">
          <div class="flex h-20 w-20 items-center justify-center rounded-full bg-green-100">
            <svg class="h-10 w-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>
        <h1 class="mb-4 font-display text-4xl font-extrabold text-foreground md:text-5xl">
          {content.congratsHeading}
        </h1>
        <p class="mb-2 text-xl font-medium text-openhr-teal-900">
          {content.congratsSubheading}
        </p>
        <p class="text-lg text-gray-600">
          {content.congratsMessage}
        </p>
      </div>

      <!-- Timeline Section: What Happens Next -->
      <div class="mb-12 rounded-xl bg-white p-8 shadow-lg">
        <h2 class="mb-8 text-center font-display text-2xl font-bold text-foreground">
          {content.timelineHeading}
        </h2>
        <ol class="relative border-l-2 border-openhr-teal-200 ml-4">
          {content.timelineSteps.map((step, index) => (
            <li class="mb-8 ml-6 last:mb-0">
              <!-- Timeline dot -->
              <span class="absolute -left-4 flex h-8 w-8 items-center justify-center rounded-full bg-openhr-teal-900 text-sm font-bold text-white ring-4 ring-white">
                {step.number}
              </span>
              <div class="pl-2">
                <h3 class="mb-1 font-display text-lg font-semibold text-foreground">
                  {step.title}
                </h3>
                <p class="text-gray-600">
                  {step.description}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Primary CTA Button -->
      <div class="mb-12 text-center">
        <a
          href="https://app.open-hr.work/dashboard"
          class="inline-flex items-center gap-2 rounded-lg bg-openhr-teal-900 px-8 py-4 text-lg font-semibold text-white shadow-lg transition-all hover:bg-openhr-teal-800 hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-openhr-teal-500/50"
        >
          {content.ctaButton}
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>

      <!-- FAQ Accordion Section -->
      <div class="mb-12">
        <h2 class="mb-6 text-center font-display text-2xl font-bold text-foreground">
          {content.faqHeading}
        </h2>
        <FAQAccordion
          client:load
          items={content.faqItems}
          expandLabel={content.expandLabel}
          collapseLabel={content.collapseLabel}
        />
      </div>

      <!-- Back to Home Link -->
      <div class="text-center">
        <a
          href={`/${locale}/`}
          class="inline-flex items-center gap-2 text-openhr-teal-900 transition-colors hover:text-openhr-teal-700"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          {content.backHome}
        </a>
      </div>
    </div>
  </section>
</MainLayout>
