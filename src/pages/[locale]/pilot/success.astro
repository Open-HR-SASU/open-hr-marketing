---
/**
 * Pilot Success Page
 *
 * Landing page after successful pilot signup/checkout.
 * Displays confirmation, timeline, dashboard CTA, and FAQ.
 *
 * URL: /{locale}/pilot/success?name={optional_name}
 *
 * @see OPE-388 - Pilot Stripe Checkout Integration
 * @see DL-30-T - Pilot Timeline (mobile app March 2026)
 * @see DL-33 - Pilot Pricing Decision
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Mark from '@/components/Mark.astro';
import FAQAccordion from '@/components/islands/FAQAccordion';
import { locales, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Get optional name from query params for personalization
const url = new URL(Astro.request.url);
const userName = url.searchParams.get('name');

// Localized content for all 6 locales
const content = {
