    congratsSubheading: 'Vous faites partie du pilote Open HR.',
    congratsMessage: 'Merci de nous rejoindre. Vous allez participer a la revolution des references professionnelles.',
    // Timeline section
    timelineHeading: 'Que se passe-t-il ensuite ?',
    timelineSteps: [
