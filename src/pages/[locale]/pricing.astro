---
/**
 * Pricing Page
 *
 * Interactive pricing display with monthly/annual toggle.
 * Uses React island for the toggle functionality.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Mark from '@/components/Mark.astro';
import PricingPageToggle from '@/components/islands/PricingPageToggle';
import { locales, type Locale } from '@/lib/i18n';
import { generateProductSchema, generateBreadcrumbSchema } from '@/lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Localized content
const content = {
  fr: {
    title: 'Tarifs - Open HR',
    description: 'Gratuit pour les travailleurs. Toujours. Tarification par evaluation pour les employeurs.',
    heading: 'Gratuit pour les travailleurs. Toujours.',
    subheading: 'Votre reputation professionnelle verifiee, sans frais.',
  },
  'en-GB': {
    title: 'Pricing - Open HR',
    description: 'Free for workers. Always. Per-assessment pricing for employers.',
    heading: 'Free for workers. Always.',
    subheading: 'Your verified professional reputation, at no cost.',
  },
  'en-US': {
    title: 'Pricing - Open HR',
    description: 'Free for workers. Always. Per-assessment pricing for employers.',
    heading: 'Free for workers. Always.',
    subheading: 'Your verified professional reputation, at no cost.',
  },
  de: {
    title: 'Preise - Open HR',
    description: 'Kostenlos fur Arbeitnehmer. Immer. Preis pro Bewertung fur Arbeitgeber.',
    heading: 'Kostenlos fur Arbeitnehmer. Immer.',
    subheading: 'Ihr verifiziertes Berufsprofil, ohne Kosten.',
  },
  es: {
    title: 'Precios - Open HR',
    description: 'Gratis para trabajadores. Siempre. Precio por evaluacion para empleadores.',
    heading: 'Gratis para trabajadores. Siempre.',
    subheading: 'Tu reputacion profesional verificada, sin coste.',
  },
  it: {
    title: 'Prezzi - Open HR',
    description: 'Gratuito per i lavoratori. Sempre. Prezzo per valutazione per i datori di lavoro.',
    heading: 'Gratuito per i lavoratori. Sempre.',
    subheading: 'La tua reputazione professionale verificata, senza costi.',
  },
}[locale];

// Generate Product schema for pricing page (OPE-421)
const productSchema = generateProductSchema(locale);

// Breadcrumb structured data (OPE-698)
const breadcrumbNames: Record<Locale, string> = {
  'fr': 'Tarifs',
  'en-GB': 'Pricing',
  'en-US': 'Pricing',
  'de': 'Preise',
  'es': 'Precios',
  'it': 'Prezzi',
};
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Open HR', url: `/${locale}/` },
  { name: breadcrumbNames[locale], url: `/${locale}/pricing/` },
]);
---

<MainLayout
  title={content.title}
  description={content.description}
  locale={locale}
  additionalSchemas={[productSchema, breadcrumbSchema]}
  pagePath="/pricing/"
>
  <section class="container py-16 md:py-24">
    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-6 flex justify-center">
        <Mark size="lg" class="text-openhr-teal-900" />
      </div>
      <h1 class="mb-4 font-display text-4xl font-extrabold text-foreground md:text-5xl">
        {content.heading}
      </h1>
      <p class="text-xl text-gray-600">
        {content.subheading}
      </p>
    </div>

    <!-- Pricing Section with Workers/Employers Toggle (React Island) -->
    <PricingPageToggle locale={locale} client:load />
  </section>
</MainLayout>
