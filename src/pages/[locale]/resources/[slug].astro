---
/**
 * Resource Detail Page
 *
 * Renders a single downloadable resource with cover image, metadata,
 * description, and the download CTA (Bunny CDN URL).
 *
 * Route: /[locale]/resources/[slug]/
 */

import MainLayout from '@/layouts/MainLayout.astro';
import ResourceDetailHero from '@/components/resources/ResourceDetailHero.astro';
import { locales, type Locale, getResourceLabels } from '@/lib/i18n';
import { getResourceSlugs, getResource } from '@/lib/sanity';

export async function getStaticPaths() {
  const paths = [];

  for (const locale of locales) {
    try {
      // Use slug-only query — avoids fetching full document data at path generation time
      const slugs = await getResourceSlugs(locale);
      for (const { slug } of slugs) {
        paths.push({ params: { locale, slug } });
      }
    } catch {
      // Sanity unavailable at build time — no paths generated for this locale
    }
  }

  return paths;
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const labels = getResourceLabels(locale);

// getStaticPaths only emits this path when the resource exists,
// so null is not expected at build time. Guard handles future edge cases.
const resource = await getResource(slug, locale);

if (!resource) {
  // Static output: render a minimal 404-style response rather than redirect
  return new Response(null, { status: 404 });
}

// SEO
const title = resource.seo?.metaTitle || `${resource.title} — Open HR`;
const description = resource.seo?.metaDescription || resource.description;
const ogImage = resource.seo?.ogImage?.asset?.url || resource.coverImage?.asset?.url;
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  ogImage={ogImage}
>
  <ResourceDetailHero resource={resource} locale={locale} />
</MainLayout>
