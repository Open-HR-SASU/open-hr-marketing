---
/**
 * Resource Library Page
 *
 * Lists all downloadable resources for the current locale.
 * Static generation — all resources fetched at build time from Sanity.
 *
 * Route: /[locale]/resources/
 */

import MainLayout from '@/layouts/MainLayout.astro';
import ResourceCard from '@/components/resources/ResourceCard.astro';
import { locales, type Locale, getResourceLabels } from '@/lib/i18n';
import { getResources } from '@/lib/sanity';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const labels = getResourceLabels(locale);

const resources = await getResources(locale);

const title = `${labels.libraryHeading} — Open HR`;
const description = labels.librarySubheading;
---

<MainLayout title={title} description={description} locale={locale}>
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
      <!-- Page heading -->
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h1 class="mb-4 font-display text-display-2 font-extrabold text-foreground md:text-display-1">
          {labels.libraryHeading}
        </h1>
        <p class="text-lg text-gray-600">
          {labels.librarySubheading}
        </p>
      </div>

      <!-- Resource grid -->
      {resources.length > 0 ? (
        <ul class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {resources.map((resource) => (
            <li>
              <ResourceCard resource={resource} locale={locale} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-center text-gray-500">{labels.noResources}</p>
      )}
    </div>
  </section>
</MainLayout>
