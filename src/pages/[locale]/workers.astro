---
/**
 * Workers Page
 *
 * CMS-powered page for workers/employees.
 * Generates static pages for all 6 locales.
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionsRenderer from '@/components/sections/SectionsRenderer.astro';
import { locales, type Locale } from '@/lib/i18n';
import { getPage, getPageMetadata } from '@/lib/sanity';
import { generateBreadcrumbSchema } from '@/lib/seo';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };

// Fetch page content from Sanity
const page = await getPage('workers', locale);
const metadata = await getPageMetadata('workers', locale);

// Fallback content
const fallbackTitle = {
  'fr': 'Pour les travailleurs - Open HR',
  'en-GB': 'For Workers - Open HR',
  'en-US': 'For Workers - Open HR',
  'de': 'Fur Arbeitnehmer - Open HR',
  'es': 'Para trabajadores - Open HR',
  'it': 'Per i lavoratori - Open HR',
}[locale];

const fallbackDescription = {
  'fr': 'Construisez une accréditation professionnelle vérifiée avec RefScore. Des références anonymes prouvent comment vous travaillez vraiment.',
  'en-GB': 'Build a verified professional credential with RefScore. Anonymous references prove how you really work.',
  'en-US': 'Build a verified professional credential with RefScore. Anonymous references prove how you really work.',
  'de': 'Erstellen Sie eine verifizierte berufliche Akkreditierung mit RefScore. Anonyme Referenzen beweisen, wie Sie wirklich arbeiten.',
  'es': 'Construye una acreditación profesional verificada con RefScore. Las referencias anónimas demuestran cómo trabajas realmente.',
  'it': 'Costruisci una credenziale professionale verificata con RefScore. Le referenze anonime dimostrano come lavori davvero.',
}[locale];

const title = metadata?.seo?.metaTitle || metadata?.title || fallbackTitle;
const description = metadata?.seo?.metaDescription || fallbackDescription;

// Breadcrumb structured data (OPE-698)
const breadcrumbNames: Record<Locale, string> = {
  'fr': 'Pour les travailleurs',
  'en-GB': 'For Workers',
  'en-US': 'For Workers',
  'de': 'Für Arbeitnehmer',
  'es': 'Para trabajadores',
  'it': 'Per i lavoratori',
};
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Open HR', url: `/${locale}/` },
  { name: breadcrumbNames[locale], url: `/${locale}/workers/` },
]);
---

<MainLayout
  title={title}
  description={description}
  locale={locale}
  additionalSchemas={[breadcrumbSchema]}
  pagePath="/workers/"
>
  {page?.sections && page.sections.length > 0 ? (
    <SectionsRenderer sections={page.sections} locale={locale} />
  ) : (
    <section class="container py-24 text-center">
      <h1 class="text-display-2 text-foreground mb-6">
        {locale === 'fr' ? 'Pour les travailleurs' : 'For Workers'}
      </h1>
      <p class="text-body text-muted-foreground max-w-2xl mx-auto mb-8">
        {fallbackDescription}
      </p>
      <a href={`/${locale}/`} class="btn btn-primary">
        {locale === 'fr' ? 'Retour a l\'accueil' : 'Back to Home'}
      </a>
    </section>
  )}
</MainLayout>
