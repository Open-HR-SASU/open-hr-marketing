---
import Layout from '@/layouts/Layout.astro';

const title = 'English tutoring with Johnathen Evans-Guilbault — Bordeaux & online';
const description = 'CEFR-anchored 1:1 English lessons for adults, exam candidates, and corporate teams. Native fluency, structured method, written progress reports. Trial session €30.';
---

<Layout title={title} description={description} locale="en-US" pagePath="/">
  <main class="flex-1">

    <!-- Top bar: lineage + parent brand link -->
    <header class="bg-white border-b border-stone-200">
      <div class="mx-auto max-w-5xl px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/openhr-mark.svg" alt="" width="36" height="36" class="rounded" />
          <span class="text-base font-semibold text-stone-900" style="font-family: 'Bricolage Grotesque', sans-serif;">
            Open&nbsp;HR <span aria-hidden="true" class="text-stone-600 font-normal mx-1">·</span> <span class="text-[#00625A]">English</span>
          </span>
        </a>
        <a href="https://app.open-hr.work/" class="text-sm text-stone-600 hover:text-[#00625A] transition">
          Open HR Platform →
        </a>
      </div>
    </header>

    <!-- Hero: parchment surface, portrait inset -->
    <section class="bg-[#F8F4ED] border-b border-stone-200">
      <div class="mx-auto max-w-5xl px-6 py-20 md:py-24 grid lg:grid-cols-3 gap-12 items-center">
        <div class="lg:col-span-2 order-2 lg:order-1">
          <p class="text-sm uppercase tracking-widest text-[#00625A] font-semibold mb-4">
            1:1 English tutoring · Bordeaux Métropole &amp; online
          </p>
          <h1 class="text-4xl md:text-6xl font-bold text-stone-900 leading-tight mb-6" style="font-family: 'Bricolage Grotesque', sans-serif;">
            English tutoring with<br />Johnathen Evans-Guilbault
          </h1>
          <p class="text-lg md:text-xl text-stone-700 max-w-2xl mb-8 leading-relaxed" style="font-family: Georgia, 'Source Serif Pro', serif;">
            Native English speaker, master's-level qualified, with prior experience designing and delivering graduate-level course series. CEFR-anchored 1:1 lessons for adult learners, exam candidates, and corporate teams in Bordeaux and online.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="https://calendly.com/johnathen-open-hr/trial_period"
               class="inline-flex items-center justify-center px-8 py-4 bg-[#00625A] hover:bg-[#004F49] text-white font-semibold rounded-lg transition">
              Book a trial session — €30
            </a>
            <a href="#pricing"
               class="inline-flex items-center justify-center px-8 py-4 border-2 border-[#00625A] text-[#00625A] hover:bg-[#00625A]/5 font-semibold rounded-lg transition">
              See packages
            </a>
          </div>
          <p class="mt-6 text-sm text-stone-600">
            Trial fee credited to any package purchased within 14 days · Written diagnostic report within 48 hours
          </p>
        </div>

        <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
          <picture>
            <source srcset="/portrait/johnathen-800.webp" type="image/webp" />
            <img
              src="/portrait/johnathen-800.jpg"
              alt="Johnathen Evans-Guilbault, English tutor and founder of Open HR"
              width="320"
              height="320"
              class="w-64 h-64 lg:w-80 lg:h-80 object-cover rounded-2xl shadow-xl ring-1 ring-black/5"
              loading="eager"
            />
          </picture>
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <section class="bg-white border-b border-stone-200">
      <div class="mx-auto max-w-5xl px-6 py-16">
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-xl font-semibold text-stone-900 mb-3" style="font-family: 'Bricolage Grotesque', sans-serif;">Native fluency, structured pedagogy</h3>
            <p class="text-stone-700 leading-relaxed">
              Native English from the United States. Master's-level academic background. Prior teaching experience in theology and business — instructional design transferred directly to language pedagogy.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-stone-900 mb-3" style="font-family: 'Bricolage Grotesque', sans-serif;">CEFR-anchored, exam-ready</h3>
            <p class="text-stone-700 leading-relaxed">
              Every learner placed on the Common European Framework. Targeted preparation for TOEIC, IELTS, TOEFL, Cambridge B2 First &amp; C1 Advanced. Communicative method grounded in Paul Nation's <em>Four Strands</em>.
            </p>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-stone-900 mb-3" style="font-family: 'Bricolage Grotesque', sans-serif;">Bordeaux &amp; online</h3>
            <p class="text-stone-700 leading-relaxed">
              In-person across Villenave-d'Ornon, Pessac, Talence, Bègles, central Bordeaux. Remote 1:1 via Zoom for learners further afield. Corporate engagements delivered on-site or hybrid.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pedagogy / credentials (NEW) -->
    <section class="bg-[#F8F4ED] border-b border-stone-200">
      <div class="mx-auto max-w-5xl px-6 py-20">
        <p class="text-sm uppercase tracking-widest text-[#00625A] font-semibold mb-3">Pedagogy, not just fluency</p>
        <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6 max-w-3xl" style="font-family: 'Bricolage Grotesque', sans-serif;">
          Native fluency is the floor — not the ceiling.
        </h2>
        <div class="max-w-3xl text-lg text-stone-700 leading-relaxed space-y-5 mb-12" style="font-family: Georgia, 'Source Serif Pro', serif;">
          <p>
            Lessons will be structured rather than improvised because the work has already been done elsewhere.
          </p>
          <p>
            Before founding Open HR, I designed and delivered four multi-week graduate-level course series in theology and biblical literature at St. James — full lesson plans, handouts, slide decks, and speaker notes for each. The pedagogical apparatus is what transfers: scaffolded learning arcs, exit assessments, adult-learner outcomes. Same spine, applied to language.
          </p>
        </div>

        <!-- Credibility tiles -->
        <div class="grid sm:grid-cols-3 gap-6 max-w-3xl">
          <div class="border border-stone-300 rounded-xl p-6 bg-white/60">
            <p class="text-4xl font-bold text-[#00625A] mb-1" style="font-family: 'Bricolage Grotesque', sans-serif;">4</p>
            <p class="text-sm text-stone-600 leading-snug">Multi-week graduate-level course series designed and delivered</p>
          </div>
          <div class="border border-stone-300 rounded-xl p-6 bg-white/60">
            <p class="text-4xl font-bold text-[#00625A] mb-1" style="font-family: 'Bricolage Grotesque', sans-serif;">20+</p>
            <p class="text-sm text-stone-600 leading-snug">Distinct lessons with full plans, handouts, and slide decks</p>
          </div>
          <div class="border border-stone-300 rounded-xl p-6 bg-white/60">
            <p class="text-4xl font-bold text-[#00625A] mb-1" style="font-family: 'Bricolage Grotesque', sans-serif;">200+</p>
            <p class="text-sm text-stone-600 leading-snug">Instructional artefacts produced — the pedagogical receipts</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="bg-white border-b border-stone-200">
      <div class="mx-auto max-w-5xl px-6 py-20">
        <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-3" style="font-family: 'Bricolage Grotesque', sans-serif;">Packages &amp; pricing</h2>
        <p class="text-stone-600 mb-12 max-w-2xl">
          Sold as packages, not single lessons. Discount for commitment. Validity windows protect pace. All prices: TVA non applicable, art. 293 B du CGI.
        </p>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">

          <div class="border border-stone-200 rounded-xl p-6 flex flex-col">
            <p class="text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Trial</p>
            <h3 class="text-2xl font-bold text-stone-900 mb-2" style="font-family: 'Bricolage Grotesque', sans-serif;">Diagnostic</h3>
            <p class="text-3xl font-bold text-[#00625A] mb-4">€30<span class="text-base font-normal text-stone-500"> / 60 min</span></p>
            <ul class="text-sm text-stone-700 space-y-2 mb-6 flex-1">
              <li>• 4-skill structured assessment</li>
              <li>• CEFR placement</li>
              <li>• Written report within 48 hr</li>
              <li>• €30 credited to any package within 14 days</li>
            </ul>
          </div>

          <div class="border border-stone-200 rounded-xl p-6 flex flex-col">
            <p class="text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Package A</p>
            <h3 class="text-2xl font-bold text-stone-900 mb-2" style="font-family: 'Bricolage Grotesque', sans-serif;">Foundation</h3>
            <p class="text-3xl font-bold text-[#00625A] mb-1">€420<span class="text-base font-normal text-stone-500"> / 10 lessons</span></p>
            <p class="text-sm text-stone-500 mb-4">€42 per hour · 4-month validity</p>
            <ul class="text-sm text-stone-700 space-y-2 mb-6 flex-1">
              <li>• 10 × 60-min lessons</li>
              <li>• Fixed weekly slot</li>
              <li>• Mid-package CEFR check-in</li>
              <li>• General adult learners, B1–B2</li>
            </ul>
          </div>

          <div class="border-2 border-[#00625A] rounded-xl p-6 flex flex-col relative shadow-lg">
            <span class="absolute -top-3 left-6 bg-[#00625A] text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">Most popular</span>
            <p class="text-xs uppercase tracking-widest text-[#00625A] font-semibold mb-2">Package B</p>
            <h3 class="text-2xl font-bold text-stone-900 mb-2" style="font-family: 'Bricolage Grotesque', sans-serif;">Progress</h3>
            <p class="text-3xl font-bold text-[#00625A] mb-1">€780<span class="text-base font-normal text-stone-500"> / 20 lessons</span></p>
            <p class="text-sm text-stone-500 mb-4">€39 per hour · 7-month validity</p>
            <ul class="text-sm text-stone-700 space-y-2 mb-6 flex-1">
              <li>• 20 × 60-min lessons</li>
              <li>• 1–2 fixed weekly slots</li>
              <li>• Monthly written progress reports</li>
              <li>• Mid + end CEFR re-assessment</li>
              <li>• Priority rescheduling</li>
            </ul>
          </div>

          <div class="border border-stone-200 rounded-xl p-6 flex flex-col">
            <p class="text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Package C</p>
            <h3 class="text-2xl font-bold text-stone-900 mb-2" style="font-family: 'Bricolage Grotesque', sans-serif;">Specialist</h3>
            <p class="text-3xl font-bold text-[#00625A] mb-1">€600–750<span class="text-base font-normal text-stone-500"> / 10 lessons</span></p>
            <p class="text-sm text-stone-500 mb-4">€60–75 per hour</p>
            <ul class="text-sm text-stone-700 space-y-2 mb-6 flex-1">
              <li>• Exam intensives (TOEIC, IELTS, TOEFL)</li>
              <li>• Cambridge B2 First / C1 Advanced</li>
              <li>• Academic English, thesis writing</li>
              <li>• Practice papers + extended writing feedback</li>
            </ul>
          </div>
        </div>

        <p class="mt-8 text-sm text-stone-500 text-center">À la carte sessions: €45 / hour</p>
      </div>
    </section>

    <!-- Corporate -->
    <section class="bg-[#0F2926] text-white">
      <div class="mx-auto max-w-5xl px-6 py-20">
        <p class="text-sm uppercase tracking-widest text-[#7BC9C0] font-semibold mb-4">Package D</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: 'Bricolage Grotesque', sans-serif;">Corporate &amp; team training</h2>
        <p class="text-lg text-stone-200 max-w-3xl mb-6 leading-relaxed">
          Tailored English training for export teams, hospitality groups, and tech companies across the Bordeaux Métropole. Delivered as a <em>convention de formation</em> through Open HR SASU, with structured curriculum, attendance tracking, and end-of-engagement reporting.
        </p>
        <div class="grid sm:grid-cols-2 gap-x-12 gap-y-3 max-w-3xl text-stone-200 mb-8">
          <p>• €70–120 per hour, scoped per engagement</p>
          <p>• 1:1 or small-group (up to 4 learners)</p>
          <p>• Typically 20–40 hours over 3–6 months</p>
          <p>• Wine &amp; spirits, tech, hospitality, higher ed</p>
        </div>
        <a href="mailto:johnathen@open-hr.work?subject=Corporate%20training%20enquiry"
           class="inline-flex items-center justify-center px-8 py-4 bg-white text-stone-900 hover:bg-stone-100 font-semibold rounded-lg transition">
          Request a corporate quote
        </a>
      </div>
    </section>

    <!-- Method -->
    <section class="bg-white border-b border-stone-200">
      <div class="mx-auto max-w-3xl px-6 py-20">
        <h2 class="text-3xl font-bold text-stone-900 mb-6" style="font-family: 'Bricolage Grotesque', sans-serif;">Method</h2>
        <div class="space-y-4 text-stone-700 leading-relaxed text-lg" style="font-family: Georgia, 'Source Serif Pro', serif;">
          <p>
            Lessons are built on the <strong>Common European Framework</strong> (CEFR) and its 2020 Companion Volume. Every learner is placed, tracked, and re-assessed against the same scale used by Cambridge English, TOEIC, IELTS, and TOEFL.
          </p>
          <p>
            Pedagogy follows <strong>Communicative Language Teaching</strong> with task-based elements, structured around Paul Nation's <em>Four Strands</em>: meaning-focused input, meaning-focused output, language-focused learning, and fluency development. Reference texts include Swan's <em>Practical English Usage</em> and Thornbury's <em>About Language</em>.
          </p>
          <p>
            Discipline matters more than charm. Each lesson alternates fluency-focused and accuracy-focused activities, with the mode signalled explicitly to the learner.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="bg-[#00625A] text-white">
      <div class="mx-auto max-w-3xl px-6 py-20 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: 'Bricolage Grotesque', sans-serif;">Start with a trial session</h2>
        <p class="text-lg text-white/85 mb-8 max-w-xl mx-auto">
          Sixty minutes, four skills, written report. €30, fully credited toward any package within fourteen days.
        </p>
        <a href="https://calendly.com/johnathen-open-hr/trial_period"
           class="inline-flex items-center justify-center px-8 py-4 bg-white text-[#00625A] hover:bg-stone-100 font-semibold rounded-lg transition">
          Book your trial session
        </a>
      </div>
    </section>

    <!-- Footer with mark seal -->
    <footer class="bg-[#F8F4ED] border-t border-stone-200">
      <div class="mx-auto max-w-5xl px-6 py-12 text-sm text-stone-600 leading-relaxed">
        <div class="flex items-center gap-3 mb-4">
          <img src="/openhr-mark.svg" alt="" width="32" height="32" class="rounded" />
          <p class="font-semibold text-stone-900" style="font-family: 'Bricolage Grotesque', sans-serif;">
            Open&nbsp;HR SASU
          </p>
        </div>
        <p class="mb-1">RCS Paris 994 927 242 — Capital social €1,500</p>
        <p class="mb-1">Siège social : 60 rue François Ier, 75008 Paris (France)</p>
        <p class="mb-1">Opérations : Villenave-d'Ornon, Gironde (Bordeaux Métropole)</p>
        <p class="mb-1">Directeur de la publication : Johnathen Fate Evans-Guilbault</p>
        <p class="mb-1">Hébergeur : Bunny.net (BunnyWay d.o.o., Slovenia)</p>
        <p class="mb-4">TVA non applicable, art. 293 B du CGI</p>
        <p>
          <a href="/fr/legal/mentions-legales/" class="text-[#00625A] hover:underline">Mentions légales</a> ·
          <a href="/fr/legal/politique-confidentialite/" class="text-[#00625A] hover:underline">Politique de confidentialité</a> ·
          <a href="/fr/legal/cgv/" class="text-[#00625A] hover:underline">CGV</a>
        </p>
      </div>
    </footer>
  </main>
</Layout>
