---
/**
 * Dashboard Mockup Screen
 *
 * Worker dashboard showing RefScore radar, identity verification, and activity.
 * i18n enabled for all 6 locales.
 */

import MockupLayout from '@/layouts/MockupLayout.astro';
import { getMockupTranslations } from '@/lib/mockups/translations';
import { locales, type Locale } from '@/lib/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getMockupTranslations(locale);
---

<MockupLayout title={`${t.common.appName} - Dashboard`} locale={locale}>
  <style>
    .app-header {
      background: var(--color-background);
      border-bottom: 1px solid var(--color-border);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo-mark {
      width: 28px;
      height: 28px;
      background: var(--color-primary);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logo-mark svg {
      width: 16px;
      height: 16px;
      color: white;
    }

    .logo-text {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 16px;
      color: var(--color-primary);
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      font-size: 12px;
    }

    .main-content {
      padding: 16px;
    }

    .welcome {
      margin-bottom: 16px;
    }

    .welcome h1 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      color: var(--color-gray-900);
      margin-bottom: 2px;
    }

    .welcome p {
      color: var(--color-gray-500);
      font-size: 13px;
    }

    .card-stack {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .card-title {
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: 600;
      color: var(--color-gray-900);
    }

    /* RefScore Card */
    .refscore-card {
      padding: 16px;
    }

    .score-display {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 12px;
    }

    .radar-container {
      width: 100px;
      height: 100px;
      flex-shrink: 0;
    }

    .radar-svg {
      width: 100%;
      height: 100%;
    }

    .score-info {
      flex: 1;
    }

    .score-label {
      font-size: 11px;
      color: var(--color-gray-500);
      margin-bottom: 2px;
    }

    .score-band {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 4px;
    }

    .score-desc {
      font-size: 11px;
      color: var(--color-gray-600);
      line-height: 1.4;
    }

    .cta-button {
      width: 100%;
      margin-top: 8px;
      font-size: 13px;
      padding: 10px 16px;
    }

    /* Identity Card */
    .identity-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .identity-item {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .identity-icon {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-md);
      background: var(--color-gray-100);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-gray-500);
      flex-shrink: 0;
    }

    .identity-icon.verified {
      background: var(--color-green-50);
      color: #166534;
    }

    .identity-text {
      flex: 1;
      min-width: 0;
    }

    .identity-label {
      font-size: 10px;
      color: var(--color-gray-500);
    }

    .identity-value {
      font-size: 12px;
      color: var(--color-gray-900);
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .identity-status {
      font-size: 10px;
      display: flex;
      align-items: center;
      gap: 3px;
      flex-shrink: 0;
    }

    .identity-status.verified {
      color: var(--color-green-500);
    }

    .identity-status.pending {
      color: var(--color-amber-500);
    }

    /* Activity Card */
    .activity-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .activity-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .activity-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-primary);
      margin-top: 5px;
      flex-shrink: 0;
    }

    .activity-dot.completed {
      background: var(--color-green-500);
    }

    .activity-dot.pending {
      background: var(--color-amber-500);
    }

    .activity-content {
      flex: 1;
    }

    .activity-text {
      font-size: 12px;
      color: var(--color-gray-900);
    }

    .activity-time {
      font-size: 10px;
      color: var(--color-gray-400);
    }
  </style>

  <!-- App Header -->
  <header class="app-header">
    <div class="logo">
      <div class="logo-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7V17L12 22L22 17V7L12 2Z"/>
        </svg>
      </div>
      <span class="logo-text">{t.common.appName}</span>
    </div>
    <div class="avatar user-avatar">JD</div>
  </header>

  <!-- Main Content -->
  <main class="main-content">
    <div class="welcome">
      <h1>{t.dashboard.greeting} {t.dashboard.userName}</h1>
      <p>{t.dashboard.subtitle}</p>
    </div>

    <div class="card-stack">
      <!-- RefScore Card -->
      <div class="card refscore-card">
        <div class="card-header">
          <span class="card-title">{t.dashboard.yourRefScore}</span>
          <span class="badge badge-success">5 {t.dashboard.references}</span>
        </div>
        <div class="score-display">
          <div class="radar-container">
            <svg class="radar-svg" viewBox="0 0 100 100">
              <polygon points="50,10 85,30 85,70 50,90 15,70 15,30" fill="none" stroke="#E2E8F0" stroke-width="0.5"/>
              <polygon points="50,20 75,35 75,65 50,80 25,65 25,35" fill="none" stroke="#E2E8F0" stroke-width="0.5"/>
              <polygon points="50,30 65,40 65,60 50,70 35,60 35,40" fill="none" stroke="#E2E8F0" stroke-width="0.5"/>
              <line x1="50" y1="50" x2="50" y2="10" stroke="#E2E8F0" stroke-width="0.5"/>
              <line x1="50" y1="50" x2="85" y2="30" stroke="#E2E8F0" stroke-width="0.5"/>
              <line x1="50" y1="50" x2="85" y2="70" stroke="#E2E8F0" stroke-width="0.5"/>
              <line x1="50" y1="50" x2="50" y2="90" stroke="#E2E8F0" stroke-width="0.5"/>
              <line x1="50" y1="50" x2="15" y2="70" stroke="#E2E8F0" stroke-width="0.5"/>
              <line x1="50" y1="50" x2="15" y2="30" stroke="#E2E8F0" stroke-width="0.5"/>
              <polygon points="50,18 78,33 80,63 50,78 28,65 23,35" fill="#006064" fill-opacity="0.15" stroke="#006064" stroke-width="1"/>
              <circle cx="50" cy="18" r="2" fill="#006064"/>
              <circle cx="78" cy="33" r="2" fill="#006064"/>
              <circle cx="80" cy="63" r="2" fill="#006064"/>
              <circle cx="50" cy="78" r="2" fill="#006064"/>
              <circle cx="28" cy="65" r="2" fill="#006064"/>
              <circle cx="23" cy="35" r="2" fill="#006064"/>
            </svg>
          </div>
          <div class="score-info">
            <div class="score-label">{t.dashboard.level}</div>
            <div class="score-band">{t.dashboard.levelHigh}</div>
            <div class="score-desc">{t.dashboard.basedOn.replace('{count}', '5').replace('{types}', '4')}</div>
          </div>
        </div>
        <button class="btn btn-primary cta-button">{t.dashboard.inviteNew}</button>
      </div>

      <!-- Identity Card -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">{t.dashboard.identityVerification}</span>
        </div>
        <div class="identity-list">
          <div class="identity-item">
            <div class="identity-icon verified">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="4" y="4" width="16" height="16" rx="2"/>
                <path d="M4 10h16"/>
              </svg>
            </div>
            <div class="identity-text">
              <div class="identity-label">{t.dashboard.email}</div>
              <div class="identity-value">j.dupont@email.com</div>
            </div>
            <span class="identity-status verified">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {t.common.verified}
            </span>
          </div>
          <div class="identity-item">
            <div class="identity-icon verified">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/>
              </svg>
            </div>
            <div class="identity-text">
              <div class="identity-label">{t.dashboard.phone}</div>
              <div class="identity-value">+33 6 •• •• 42</div>
            </div>
            <span class="identity-status verified">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {t.common.verified}
            </span>
          </div>
          <div class="identity-item">
            <div class="identity-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="16" rx="2"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </div>
            <div class="identity-text">
              <div class="identity-label">{t.dashboard.idDocument}</div>
              <div class="identity-value">{t.dashboard.notVerified}</div>
            </div>
            <span class="identity-status pending">{t.common.pending}</span>
          </div>
        </div>
      </div>

      <!-- Activity Card -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">{t.dashboard.recentActivity}</span>
        </div>
        <div class="activity-list">
          <div class="activity-item">
            <div class="activity-dot completed"></div>
            <div class="activity-content">
              <div class="activity-text">{t.dashboard.completedReference.replace('{name}', 'Sophie M.')}</div>
              <div class="activity-time">{t.dashboard.hoursAgo.replace('{hours}', '2')}</div>
            </div>
          </div>
          <div class="activity-item">
            <div class="activity-dot pending"></div>
            <div class="activity-content">
              <div class="activity-text">{t.dashboard.openedInvitation.replace('{name}', 'Marc L.')}</div>
              <div class="activity-time">{t.dashboard.daysAgo.replace('{days}', '1')}</div>
            </div>
          </div>
          <div class="activity-item">
            <div class="activity-dot completed"></div>
            <div class="activity-content">
              <div class="activity-text">{t.dashboard.completedReference.replace('{name}', 'Pierre D.')}</div>
              <div class="activity-time">{t.dashboard.daysAgo.replace('{days}', '3')}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</MockupLayout>
